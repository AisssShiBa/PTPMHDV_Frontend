{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/*.test.ts",
    "test:unit": "vitest run",
    "test:browser": "node tests/run-browser-smoke.mjs",
    "test:phase3:live": "node tests/phase3-live.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "preview": "vite preview",
    "mock": "prism mock packages/api-contract/openapi.yaml -p 4010 -h 0.0.0.0",
    "contract:lint": "redocly lint --extends=minimal packages/api-contract/openapi.yaml",
    "dev:mobile": "npm run start --workspace @finvault/mobile",
    "dev:all": "concurrently -k -n web,mobile \"npm run dev\" \"npm run dev:mobile\"",
    "test:browser:legacy": "node tests/browser-smoke-legacy.mjs",
    "test:profile:live": "node tests/profile-live.mjs",
    "test:topup:browser": "node tests/topup-browser.mjs",
    "test:cashout:browser": "node tests/cashout-browser.mjs",
    "test:merchant:browser": "node tests/merchant-browser.mjs",
    "test:merchant:live": "node tests/merchant-browser.mjs --live",
    "test:merchant:tools:live": "node tests/merchant-tools-live.mjs",
    "test:funding:live": "node tests/funding-live.mjs",
    "test:huu:demo:seed": "node tests/huu-closeout-live.mjs demo",
    "test:huu:p2p:live": "node tests/huu-closeout-live.mjs p2p",
    "test:huu:demo:rehearse": "node tests/huu-demo-rehearsal.mjs",
    "test:huu:wallet:live": "node tests/huu-closeout-live.mjs wallet"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.5",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.67.1",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^12.4.7",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@redocly/cli": "^2.28.0",
    "@stoplight/prism-cli": "^5.14.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^26.0.0",
    "msw": "^2.7.3",
    "prettier": "^3.5.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.0",
    "vitest": "^3.0.7"
  }
}
