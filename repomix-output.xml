<!-- Toast Thông báo phản hồi -->
<div class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none" id="toastNotification">
<div class="flex items-center gap-3 px-5 py-3.5 rounded-xl bg-inverse-surface text-inverse-on-surface shadow-2xl border border-outline-variant/20">
<span class="material-symbols-outlined text-emerald-400" style="font-variation-settings: 'FILL' 1;">check_circle</span>
<div>
<div class="text-[14px] font-bold" id="toastTitle">Thao tác thành công</div>
<div class="text-[12px] text-outline-variant" id="toastSub">Bút toán đã được lưu vào Nhật ký kiểm toán.</div>
</div>
</div>
</div>
<script>
  function selectIncident(walletName, amount, type) {
    document.getElementById('walletInput').value = walletName;
    document.getElementById('amountInput').value = amount;
    
    const radios = document.querySelectorAll('input[name="adjust_type"]');
    radios.forEach(r => {
      r.checked = (r.value === type);
      const label = r.closest('label');
      if (r.checked) {
        label.classList.add('border-2', 'border-primary', 'bg-primary/5', 'text-primary');
        label.classList.remove('border', 'border-outline-variant/40', 'text-secondary');
      } else {
        label.classList.remove('border-2', 'border-primary', 'bg-primary/5', 'text-primary');
        label.classList.add('border', 'border-outline-variant/40', 'text-secondary');
      }
    });

    document.getElementById('reasonTextarea').focus();
    
    showToastNotification("Đã chọn sự vụ", `Đã tải thông tin ${walletName} vào biểu mẫu bút toán.`);
  }

  // Radio button click styling toggle
  document.querySelectorAll('input[name="adjust_type"]').forEach(radio => {
    radio.addEventListener('change', function() {
      document.querySelectorAll('input[name="adjust_type"]').forEach(r => {
        const label = r.closest('label');
        if (r.checked) {
          label.classList.add('border-2', 'border-primary', 'bg-primary/5', 'text-primary');
          label.classList.remove('border', 'border-outline-variant/40', 'text-secondary');
        } else {
          label.classList.remove('border-2', 'border-primary', 'bg-primary/5', 'text-primary');
          label.classList.add('border', 'border-outline-variant/40', 'text-secondary');
        }
      });
    });
  });

  function handleSubmitEntry() {
    const amount = document.getElementById('amountInput').value;
    const wallet = document.getElementById('walletInput').value;
    showToastNotification(
      "Ký duyệt & Tạo bút toán thành công", 
      `Bút toán điều chỉnh ${amount}đ cho ví ${wallet} đã lưu vào Nhật ký kiểm toán.`
    );
    document.getElementById('reasonTextarea').value = "";
  }

  function showToastNotification(title, sub) {
    const toast = document.getElementById('toastNotification');
    document.getElementById('toastTitle').textContent = title;
    document.getElementById('toastSub').textContent = sub;
    
    toast.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
    setTimeout(() => {
      toast.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
    }, 3500);
  }

  document.getElementById('runReconBtn').addEventListener('click', function() {
    const btn = this;
    const icon = document.getElementById('syncIcon');
    icon.classList.add('animate-spin');
    btn.classList.add('opacity-80', 'pointer-events-none');
    
    setTimeout(() => {
      icon.classList.remove('animate-spin');
      btn.classList.remove('opacity-80', 'pointer-events-none');
      showToastNotification(
        "Hoàn tất kiểm tra đối soát", 
        "Đã quét 158.420 tài khoản hoạt động. Xác định 2 bất thường cần lập biên bản."
      );
    }, 1200);
  });
</script>
</body></html>
