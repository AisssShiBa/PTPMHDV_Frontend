                  <CardHeader className="border-b border-border/60 pb-3">
                    <CardTitle className="text-base">Phân bổ trạng thái KYC</CardTitle>
                    <CardDescription className="text-xs">
                      Tổng {formatNumber(kycTotal)} hồ sơ người dùng
