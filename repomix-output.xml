</div>
<div class="pt-3 border-t border-outline-variant/20 flex justify-between items-baseline">
<span class="font-headline-sm font-headline-sm text-on-surface">Tổng tiền trừ ví</span>
<span class="font-currency-display text-currency-display text-primary font-bold">500.000đ</span>
</div>
</div>
</section>
