et.ts:22:7\n  20 |   useEffect(() => {\n  21 |     if (!userId || !accessToken || useMock) {\n> 22 |       setConnected(false)\n     |       ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  23 |       return\n  24 |     }\n  25 |","line":22,"column":7,"nodeType":null,"endLine":22,"endColumn":19},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":33,"column":20,"nodeType":"MemberExpression","messageId":"unexpected","endLine":33,"endColumn":33},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement.","line":41,"column":7,"nodeType":"MemberExpression","messageId":"unexpected","endLine":41,"endColumn":20,"suggestions":[{"fix":{"range":[1429,1490],"text":""},"messageId":"removeConsole","data":{"propertyName":"error"},"desc":"Remove the console.error()."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useEffect, useRef, useState } from 'react'\nimport { io } from 'socket.io-client'\nimport { notificationService } from '../services/notificationService'\nimport type { NotificationItem } from '../types/notification.types'\nimport { createSocketAuth, resolveSocketOrigin } from './socketConfig'\n\nconst apiBaseUrl = import.meta.env.VITE_API_BASE_URL ||\n  (import.meta.env.DEV ? 'http://localhost:3000/api' : '/api')\nconst useMock = import.meta.env.VITE_USE_MOCK === 'true'\n\nexport function useNotificationSocket(\n  userId: string | undefined,\n  accessToken: string | undefined,\n  onNotification: (notification: NotificationItem) => void\n) {\n  const handlerRef = useRef(onNotification)\n  const [connected, setConnected] = useState(false)\n  handlerRef.current = onNotification\n\n  useEffect(() => {\n    if (!userId || !accessToken || useMock) {\n      setConnected(false)\n      return\n    }\n\n    let active = true\n    let serverDisconnectTimer: ReturnType<typeof setTimeout> | undefined\n    setConnected(false)\n    const socket = io(resolveSocketOrigin(apiBaseUrl, window.location.origin), {\n      path: '/socket.io',\n      auth: createSocketAuth(\n        () => notificationService.getSocketTicket(),\n        (error) => console.error('Failed to fetch notification socket ticket', error)\n      )\n    })\n\n    socket.on('connect', () => {\n      if (active) setConnected(true)\n    })\n    socket.on('connect_error', (error) => {\n      console.error('Notification socket connection failed', error)\n    })\n    socket.on('disconnect', (reason) => {\n      if (active) setConnected(false)\n      if (active && reason === 'io server disconnect') {\n        serverDisconnectTimer = setTimeout(() => socket.connect(), 1000)\n      }\n    })\n    socket.on('notification:new', (notification: NotificationItem) => {\n      handlerRef.current(notification)\n    })\n\n    return () => {\n      active = false\n      if (serverDisconnectTimer) clearTimeout(serverDisconnectTimer)\n      socket.disconnect()\n    }\n  }, [userId, accessToken])\n\n  return connected\n}","usedDeprecatedRules":[]},{"filePath":"/home/nguyenhuu/Hoc Tap/HDV/PTPMHDV_Frontend/src/features/notification/index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/nguyenhuu/Hoc Tap/HDV/PTPMHDV_Frontend/src/features/notification/services/notificationService.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/nguyenhuu/Hoc Tap/HDV/PTPMHDV_Frontend/src/features/notification/types/notification.types.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/nguyenhuu/Hoc Tap/HDV/PTPMHDV_Frontend/src/features/payment/components/CheckoutModa