<div class="p-5 border-t border-outline-variant/30 bg-surface-container-lowest flex items-center justify-between gap-4 shrink-0 shadow-[0_-4px_20px_-2px_rgba(11,43,58,0.03)]">
<!-- Rejection Cluster with Dropdown Reason -->
<div class="flex items-center gap-2">
<select class="h-12 px-3 py-2 text-xs rounded-xl border border-outline-variant/50 bg-surface-container-low text-on-surface focus:border-error focus:ring-1 focus:ring-error outline-none">
<option disabled="" selected="" value="">Lý do từ chối nếu không đạt...</option>
<option value="blur">Ảnh mờ không rõ nét</option>
<option value="mismatch">Thông tin không khớp</option>
<option value="expired">Giấy tờ hết hạn</option>
<option value="other">Lý do khác</option>
</select>
<button class="h-12 px-5 rounded-xl border border-error text-error hover:bg-[#FEECEB] active:scale-95 transition-all text-xs font-semibold flex items-center gap-1.5 whitespace-nowrap" type="button">
<span class="material-symbols-outlined text-base">close</span>
              Từ chối hồ sơ
            </button>
</div>
<!-- Approval Action Button (Distinct emerald green #10B981) -->
<div class="flex items-center gap-3">
<button class="h-12 px-4 rounded-xl border border-outline-variant/40 text-on-surface-variant hover:bg-surface-container-low transition-colors text-xs font-semibold" type="button">
              Chuyển hồ sơ cấp 2
            </button>
<button class="h-12 px-8 rounded-xl bg-[#10B981] hover:bg-[#0ea372] active:scale-95 transition-all text-white font-label-lg text-label-lg shadow-md hover:shadow-lg flex items-center gap-2 cursor-pointer" type="button">
<span class="material-symbols-outlined text-lg">check_circle</span>
              Duyệt hồ sơ (Nâng Cấp 2)
            </button>
</div>
</div>
</section>
</main>
</div>
