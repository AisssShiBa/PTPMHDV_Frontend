<file path="src/features/funding/hooks/fundingIntent.ts">
import { FundingError } from '../api/funding.errors'
/** One immutable intent per mounted flow; retries share its UUID. */
export function createFundingIntent() {
  let payload: string | undefined
  let key: string | undefined
  let busy = false
  return {
    acquire(value: unknown) {
      if (busy) throw new FundingError('FUNDING_BUSY')
      const next = JSON.stringify(value)
      if (payload !== undefined && next !== payload)
        throw new FundingError('FUNDING_INTENT_CHANGED')
      payload = next
      key ??= crypto.randomUUID()
      busy = true
      return key
    },
    release() {
      busy = false
    },
  }
}
</file>

<file path="src/features/funding/hooks/useCashOutFlow.ts">
import { useEffect, useRef, useState } from 'react'
import { useQueryClient } from '@tanstack/react-query'
import { useAuthStore } from '@/features/auth'
import { walletKeys } from '@/features/wallet'
import { fundingApi, validate } from '../api/funding.api'
import { fundingError, FundingError } from '../api/funding.errors'
import { fundingKeys } from '../api/funding.queries'
import { cashoutInputSchema } from '../schemas/cashout.schema'
import type {
  CashOutInput,
  CashOutRecord,
  FundingPhase,
} from '../types/funding.types'
import { createFundingIntent } from './fundingIntent'
export function useCashOutFlow() {
  const owner = useAuthStore((state) => state.user?.id)
  const mounted = useRef(true)
  useEffect(() => {
    mounted.current = true
    return () => {
      mounted.current = false
    }
  }, [])
  const client = useQueryClient()
  const session = useRef({
    owner,
    intent: createFundingIntent(),
    confirming: false,
    confirmationSent: false,
    order: undefined as CashOutRecord | undefined,
  })
  const [view, setView] = useState<{
    owner?: string
    phase: FundingPhase
    order?: CashOutRecord
    canConfirm: boolean
  }>({ phase: 'IDLE', canConfirm: false })
  const current = () =>
    Boolean(
      mounted.current && owner && useAuthStore.getState().user?.id === owner,
    )
  const update = (phase: FundingPhase) => {
    if (current())
      setView({
        owner,
        phase,
        order: session.current.order,
        canConfirm: Boolean(
          session.current.order?.status === 'REQUESTED' &&
          !session.current.confirmationSent,
        ),
      })
  }
  function accept(order: CashOutRecord, phase: FundingPhase = 'CHECKING') {
    if (!current()) return
    if (order.userId !== owner) throw new FundingError('INVALID_RESPONSE', true)
    session.current.order = order
    client.setQueryData(fundingKeys.cashout(owner!, order.id), order)
    void client.invalidateQueries({ queryKey: walletKeys.all })
    update(phase)
    return order
  }
  async function create(input: CashOutInput) {
    if (!current()) return
    if (session.current.owner !== owner)
      session.current = {
        owner,
        intent: createFundingIntent(),
        confirming: false,
        confirmationSent: false,
        order: undefined,
      }
    const state = session.current
    const payload = validate(cashoutInputSchema, input)
    const key = state.intent.acquire(payload)
    if (state.order) {
      state.intent.release()
      throw new FundingError('FUNDING_RECONCILE_REQUIRED')
    }
    update('CREATING')
    try {
      return accept(await fundingApi.createCashOut(payload, key))
    } catch (error) {
      update(fundingError(error).outcomeUnknown ? 'UNKNOWN' : 'ERROR')
      throw error
    } finally {
      state.intent.release()
    }
  }
  async function reconcile(id?: string) {
    const orderId = id ?? session.current.order?.id
    if (!current() || !orderId || session.current.confirming) return
    if (session.current.owner !== owner)
      session.current = {
        owner,
        intent: createFundingIntent(),
        confirming: false,
        confirmationSent: true,
        order: undefined,
      }
    // Recovered orders are read-only: a lost confirmation outcome must not authorize another POST.
    if (!session.current.order || session.current.order.id !== orderId)
      session.current.confirmationSent = true
    try {
      return accept(await fundingApi.getCashOut(orderId))
    } catch (error) {
      update('UNKNOWN')
      throw error
    }
  }
  async function confirm(transactionToken: string) {
    const state = session.current
    if (!current() || state.owner !== owner || !state.order)
      throw new FundingError('FUNDING_ORDER_REQUIRED')
    if (
      state.confirming ||
      state.confirmationSent ||
      state.order.status !== 'REQUESTED'
    )
      throw new FundingError('FUNDING_RECONCILE_REQUIRED')
    state.confirming = true
    state.confirmationSent = true
    update('CONFIRMING')
    try {
      return accept(
        await fundingApi.confirmCashOut(state.order.id, transactionToken),
      )
    } catch (error) {
      update('UNKNOWN')
      // Read once immediately; never retain/replay the token. Polling continues via status queries.
      if (current()) {
        try {
          const order = await fundingApi.getCashOut(state.order.id)
          if (
            current() &&
            fundingError(error).code === 'TRANSACTION_TOKEN_EXPIRED' &&
            order.status === 'REQUESTED'
          )
            state.confirmationSent = false
          accept(order, 'UNKNOWN')
        } catch {
          /* Preserve the confirmation error and unknown outcome. */
        }
      }
      throw error
    } finally {
      state.confirming = false
    }
  }
  const visible =
    view.owner === owner
      ? view
      : { phase: 'IDLE' as const, order: undefined, canConfirm: false }
  return { ...visible, create, confirm, reconcile }
}
</file>

<file path="src/features/funding/hooks/useTopupFlow.ts">
import { useEffect, useRef, useState } from 'react'
import { useAuthStore } from '@/features/auth'
import { fundingApi } from '../api/funding.api'
import { fundingError } from '../api/funding.errors'
import type { FundingPhase } from '../types/funding.types'
import { createFundingIntent } from './fundingIntent'
export function useTopupFlow() {
  const owner = useAuthStore((state) => state.user?.id)
  const mounted = useRef(true)
  useEffect(() => {
    mounted.current = true
    return () => {
      mounted.current = false
    }
  }, [])
  const session = useRef({ owner, intent: createFundingIntent() })
  const [view, setView] = useState<{ owner?: string; phase: FundingPhase }>({
    phase: 'IDLE',
  })
  const setPhase = (phase: FundingPhase) => setView({ owner, phase })
  async function create(amount: string) {
    if (
      !mounted.current ||
      !owner ||
      useAuthStore.getState().user?.id !== owner
    )
      return
    if (session.current.owner !== owner)
      session.current = { owner, intent: createFundingIntent() }
    const intent = session.current.intent
    const key = intent.acquire({ amount })
    setPhase('CREATING')
    try {
      const result = await fundingApi.createTopup(amount, key)
      if (!mounted.current || useAuthStore.getState().user?.id !== owner) return
      setPhase('REDIRECTING')
      return result
    } catch (error) {
      const failure = fundingError(error)
      if (mounted.current && useAuthStore.getState().user?.id === owner) {
        setPhase(failure.outcomeUnknown ? 'UNKNOWN' : 'ERROR')
        if (!failure.outcomeUnknown && session.current.intent === intent)
          session.current = { owner, intent: createFundingIntent() }
      }
      throw error
    } finally {
      intent.release()
    }
  }
  return { phase: view.owner === owner ? view.phase : 'IDLE', create }
}
</file>

<file path="src/features/funding/hooks/useTopupReturn.ts">
import { useQuery } from '@tanstack/react-query'
import { z } from 'zod'
import { useAuthStore } from '@/features/auth'
import { fundingQueries, useTopupStatus } from '../api/funding.queries'
/** Correlate by exact server-owned code, never newest order or callback success flag. */
export function useTopupReturn(params: URLSearchParams) {
  const owner = useAuthStore((state) => state.user?.id) ?? ''
  const rawId = params.get('topupId')
  const code = params.get('vnp_TxnRef')
  const validId = rawId && z.uuid().safeParse(rawId).success ? rawId : undefined
  const shouldLookup =
    !rawId && Boolean(code && /^NAP[A-Z0-9]{1,64}$/.test(code))
  const history = useQuery({
    ...fundingQueries.history(owner),
    enabled: Boolean(owner && shouldLookup),
    staleTime: 0,
  })
  const matches = shouldLookup
    ? history.data?.filter((row) => row.code === code)
    : undefined
  const id = validId ?? (matches?.length === 1 ? matches[0].id : undefined)
  const status = useTopupStatus(id ?? '', Boolean(id))
  const mismatch = Boolean(code && status.data && status.data.code !== code)
  return {
    id,
    history,
    status,
    mismatch,
    resolving: shouldLookup && history.isFetching,
    ambiguous: Boolean(matches && matches.length !== 1),
  }
}
</file>

