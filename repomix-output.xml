                </span>
              </label>
              {errors.terms && (
                <p className="text-xs text-destructive font-medium mt-1">
                  {errors.terms.message}
                </p>
              )}
            </div>

            {/* Nút Tạo tài khoản */}
            <Button
              type="submit"
              size="lg"
