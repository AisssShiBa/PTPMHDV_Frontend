","messageId":"localComponents","endLine":32,"endColumn":20},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Move your component(s) to a separate file. If all exports are HOCs, add them to the `extraHOCs` option.","line":33,"column":7,"nodeType":"Identifier","messageId":"localComponents","endLine":33,"endColumn":19},{"ruleId":"react-refresh/only-export-components","severity":1,"message":"Fast refresh only works when a file only exports components. Move your component(s) to a separate file. If all exports are HOCs, add them to the `extraHOCs` option.","line":35,"column":10,"nodeType":"Identifier","messageId":"localComponents","endLine":35,"endColumn":22}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":21,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { lazy, Suspense } from 'react'\nimport { createBrowserRouter, Navigate } from 'react-router-dom'\nimport { MainLayout } from '@/layouts/MainLayout'\nimport { AuthLayout } from '@/layouts/AuthLayout'\nimport { AdminLayout } from '@/layouts/AdminLayout'\nimport { RequireAuth, RequireRole, RedirectIfAuthed } from './guards'\nimport { Loader2 } from 'lucide-react'\n\n// Lazy load các trang\nconst HomePage = lazy(() => import('@/pages/HomePage'))\nconst SignInPage = lazy(() => import('@/pages/SignInPage'))\nconst SignUpPage = lazy(() => import('@/pages/SignUpPage'))\nconst QrLoginPage = lazy(() => import('@/pages/QrLoginPage'))\n\nconst DashboardPage = lazy(() => import('@/pages/DashboardPage'))\nconst TransferPage = lazy(() => import('@/pages/TransferPage'))\nconst TopupPage = lazy(() => import('@/pages/TopupPage'))\nconst WithdrawPage = lazy(() => import('@/pages/WithdrawPage'))\nconst TransactionsPage = lazy(() => import('@/pages/TransactionsPage'))\nconst ProfilePage = lazy(() => import('@/pages/ProfilePage'))\nconst UtilitiesPage = lazy(() => import('@/pages/UtilitiesPage'))\nconst NotificationsPage = lazy(() => import('@/pages/NotificationsPage'))\n\nconst MerchantPortalPage = lazy(() => import('@/pages/MerchantPortalPage'))\nconst MerchantRegisterPage = lazy(() => import('@/pages/MerchantRegisterPage'))\n\nconst AdminDashboardPage = lazy(() => import('@/pages/AdminDashboardPage'))\nconst AdminKycPage = lazy(() => import('@/pages/AdminKycPage'))\nconst AdminReconciliationPage = lazy(() => import('@/pages/AdminReconciliationPage'))\nconst AdminTopupPage = lazy(() => import('@/pages/AdminTopupPage'))\n\nconst ForbiddenPage = lazy(() => import('@/pages/ForbiddenPage'))\nconst NotFoundPage = lazy(() => import('@/pages/NotFoundPage'))\n\nfunction PageFallback() {\n  return (\n    <div className=\"flex h-64 w-full items-center justify-center\" role=\"status\">\n      <Loader2 className=\"h-6 w-6 animate-spin text-primary\" />\n    </div>\n  )\n}\n\nfunction withSuspense(Component: React.ComponentType) {\n  return (\n    <Suspense fallback={<PageFallback />}>\n      <Component />\n    </Suspense>\n  )\n}\n\nexport const router = createBrowserRouter([\n  // 1. Công khai (Landing Page)\n  {\n    path: '/',\n    element: (\n      <RedirectIfAuthed>\n        {withSuspense(HomePage)}\n      </RedirectIfAuthed>\n    )\n  },\n\n  // 2. Auth Routes (AuthLayout)\n  {\n    element: (\n      <RedirectIfAuthed>\n        <AuthLayout />\n      </RedirectIfAuthed>\n    ),\n    children: [\n      { path: 'sign-in', element: withSuspense(SignInPage) },\n      { path: 'sign-up', element: withSuspense(SignUpPage) },\n      { path: 'qr-login', element: withSuspense(QrLoginPage) }\n    ]\n  },\n\n  // 3. Ứng dụng sau đăng nhập (MainLayout + RequireAuth)\n  {\n    path: 'app',\n    element: (\n      <RequireAuth>\n        <MainLayout />\n      </RequireAuth>\n    ),\n    children: [\n      { index: true, element: withSuspense(DashboardPage) },\n      { path: 'transfer', element: withSuspense(TransferPage) },\n      { path: 'topup', element: withSuspense(TopupPage) },\n      { path: 'withdraw', element: withSuspense(WithdrawPage) },\n      { path: 'transactions', element: withSuspense(TransactionsPage) },\n      { path: 'profile', element: withSuspense(ProfilePage) },\n      { path: 'utilities', element: withSuspense(UtilitiesPage) },\n      { path: 'notifications', element: withSuspense(NotificationsPage) }\n    ]\n  },\n\n  // 4. Cổng Merchant (MainLayout + RequireAuth)\n  {\n    path: 'merchant',\n    element: (\n      <RequireAuth>\n        <MainLayout />\n      </RequireAuth>\n    ),\n    children: [\n      { index: true, element: withSuspense(MerchantPortalPage) },\n      { path: 'register', element: withSuspense(MerchantRegisterPage) }\n    ]\n  },\n\n  // 5. Quản trị Admin (AdminLayout + RequireRole('ADMIN'))\n  {\n    path: 'admin',\n    element: (\n      <RequireAuth>\n        <RequireRole role=\"ADMIN\">\n          <AdminLayout />\n        </RequireRole>\n      </RequireAuth>\n    ),\n    children: [\n      { index: true, element: withSuspense(AdminDashboardPage) },\n      { path: 'kyc', element: withSuspense(AdminKycPage) },\n      { path: 'reconciliation', element: withSuspense(AdminReconciliationPage) },\n      { path: 'topups', element: withSuspense(AdminTopupPage) }\n    ]\n  },\n\n  // 6. Lỗi quyền và không tìm thấy trang\n  {\n    path: '403',\n    element: withSuspense(ForbiddenPage)\n  },\n  {\n    path: '404',\n    element: withSuspense(NotFoundPage)\n  },\n  {\n    path: '*',\n    element: <Navigate to=\"/404\" replace />\n  }\n])\n","usedDeprecatedRules":[]},{"filePath":"/tmp/huu-fe-baseline-ec9e776/src/components/common/ConfirmDialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/tmp/huu-fe-baseline-ec9e776/src/components/common/EmptyState.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDepre