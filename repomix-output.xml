<td class="py-4 px-5 whitespace-nowrap">
<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-sky-50 text-sky-800 text-[12px] font-bold font-mono border border-sky-200">
                    PENDING_TIMEOUT
                  </span>
</td>
<td class="py-4 px-4 whitespace-nowrap">
<div class="font-semibold text-secondary font-mono">w_9c1b...</div>
<div class="text-[12px] text-secondary">Lê Thị Mai</div>
</td>
<td class="py-4 px-4">
