<button class="px-4 py-2 rounded-xl border border-outline-variant/40 bg-surface-container-lowest hover:border-primary text-on-surface-variant hover:text-primary font-label-md text-label-md transition-colors active:scale-95" type="button">
                1.000.000đ
              </button>
<button class="px-4 py-2 rounded-xl border border-outline-variant/40 bg-surface-container-lowest hover:border-primary text-on-surface-variant hover:text-primary font-label-md text-label-md transition-colors active:scale-95" type="button">
