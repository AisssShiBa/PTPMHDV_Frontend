import { useRef } from 'react'
import { useForm } from 'react-hook-form'
import { zodResolver } from '@hookform/resolvers/zod'
import { toast } from 'sonner'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { useAuthStore } from '@/features/auth/stores/useAuthStore'
import { errorMessage } from '@/lib/apiResponse'
import { buildProfileUpdate, createProfileSchema, profileDefaults, type ProfileFormValues } from '../schemas/user.schema'
import { userService } from '../services/userService'
import type { UserProfile } from '../types/user.types'

export function ProfileForm({ profile, onSaved }: { profile: UserProfile; onSaved: (profile: UserProfile) => void }) {
  const busy = useRef(false)
  const { register, handleSubmit, reset, setError, formState: { errors, isSubmitting, isDirty } } = useForm<ProfileFormValues>({
    resolver: zodResolver(createProfileSchema(profile)),
    defaultValues: profileDefaults(profile)
  })
  const submit = async (values: ProfileFormValues) => {
    if (busy.current) return
    const payload = buildProfileUpdate(profile, values)
    if (!Object.keys(payload).length) { toast.info('Không có thông tin thay đổi.'); return }
    busy.current = true
    try {
      const saved = await userService.updateProfile(profile.authUserId, payload)
      if (useAuthStore.getState().user?.id !== profile.authUserId) return
      reset(profileDefaults(saved))
      onSaved(saved)
      toast.success('Đã cập nhật hồ sơ')
    } catch (error) {
      if (useAuthStore.getState().user?.id === profile.authUserId) setError('root', { message: errorMessage(error) })
    } finally { busy.current = false }
  }
  return <form onSubmit={handleSubmit(submit)} className="space-y-5" noValidate>
    <div className="space-y-2">
      <Label htmlFor="profile-email">Email</Label>
      <Input id="profile-email" type="email" value={profile.email} readOnly aria-describedby="email-help" />
      <p id="email-help" className="text-xs text-muted-foreground">Email đăng nhập không thể thay đổi tại đây.</p>
    </div>
    {([
      ['fullName', 'Họ và tên', 'name'],
      ['phone', 'Số điện thoại', 'tel'],
      ['address', 'Địa chỉ', 'street-address']
    ] as const).map(([name, label, autoComplete]) => <div key={name} className="space-y-2">
      <Label htmlFor={'profile-' + name}>{label}</Label>
      <Input id={'profile-' + name} type={name === 'phone' ? 'tel' : 'text'} autoComplete={autoComplete}
        {...register(name)} disabled={isSubmitting} aria-invalid={!!errors[name]} aria-describedby={errors[name] ? name + '-error' : undefined} />
      {errors[name] && <p id={name + '-error'} role="alert" className="text-sm text-destructive">{errors[name]?.message}</p>}
    </div>)}
    {errors.root && <p role="alert" className="text-sm text-destructive">{errors.root.message}</p>}
    <Button type="submit" disabled={isSubmitting || !isDirty}>{isSubmitting ? 'Đang lưu…' : 'Lưu thông tin'}</Button>
  </form>
}
</file>

<file path="src/features/user/hooks/useRecipientLookup.ts">
import { useEffect, useRef, useState } from 'react'
import axios from 'axios'
import { useAuthStore } from '@/features/auth/stores/useAuthStore'
import { errorMessage } from '@/lib/apiResponse'
import { userService } from '../services/userService'
import { lookupRetryAt, recipientQuerySchema, type Recipient } from '../schemas/recipient.schema'

// Keep the server cooldown when closing/reopening the transfer dialog; no
// recipient queries or results are persisted in browser storage.
const cooldowns = new Map<string, number>()

export function useRecipientLookup(authUserId: string) {
  const [query, setQuery] = useState('')
  const [recipient, setRecipient] = useState<Recipient | null>(null)
  const [error, setError] = useState('')
  const [loading, setLoading] = useState(false)
  const [retryAt, setRetryAt] = useState(() => cooldowns.get(authUserId) ?? 0)
  const [now, setNow] = useState(Date.now)
  const request = useRef<AbortController | null>(null)
  const remaining = Math.max(0, Math.ceil((retryAt - now) / 1000))

  useEffect(() => () => request.current?.abort(), [authUserId])
  useEffect(() => {
    if (!retryAt) return
    const tick = () => {
      const time = Date.now()
      setNow(time)
      if (time >= retryAt) { cooldowns.delete(authUserId); setRetryAt(0) }
    }
    tick()
    const timer = setInterval(tick, 250)
    return () => clearInterval(timer)
  }, [authUserId, retryAt])

  const changeQuery = (value: string) => {
    request.current?.abort(); request.current = null
    setQuery(value); setRecipient(null); setError(''); setLoading(false)
  }
  const lookup = async () => {
    if (request.current || (cooldowns.get(authUserId) ?? 0) > Date.now()) return
    const parsed = recipientQuerySchema.safeParse(query)
    setRecipient(null); setError('')
    if (!parsed.success) { setError(parsed.error.issues[0].message); return }
    const controller = new AbortController()
    request.current = controller
    setLoading(true)
    try {
      const result = await userService.lookupRecipient(parsed.data, controller.signal)
      if (controller.signal.aborted || useAuthStore.getState().user?.id !== authUserId) return
      if (result.authUserId === authUserId) {
        setError('Không tìm thấy người nhận phù hợp. Vui lòng kiểm tra lại email hoặc số điện thoại.')
        return
      }
      setRecipient(result)
    } catch (failure) {
      if (controller.signal.aborted || useAuthStore.getState().user?.id !== authUserId) return
      if (axios.isAxiosError(failure) && failure.response?.status === 429) {
        const deadline = lookupRetryAt(failure.response.headers['retry-after'])
        cooldowns.set(authUserId, deadline)
        setNow(Date.now()); setRetryAt(deadline)
      } else if (axios.isAxiosError(failure) && failure.response?.status === 404) {
        setError('Không tìm thấy người nhận phù hợp. Vui lòng kiểm tra lại email hoặc số điện thoại.')
      } else setError(errorMessage(failure))
    } finally {
      if (request.current === controller) { request.current = null; setLoading(false) }
    }
  }
  return { query, changeQuery, recipient, error, loading, remaining, lookup }
}
</file>

<file path="src/features/user/schemas/recipient.schema.ts">
import { z } from 'zod'

export const recipientQuerySchema = z.string().trim().min(1, 'Vui lòng nhập email hoặc số điện thoại người nhận.')
  .max(254, 'Thông tin tra cứu tối đa 254 ký tự.')
  .refine((value) => z.email().safeParse(value).success || /^\+?\d[\d ().-]{3,28}\d$/.test(value),
    'Vui lòng nhập email đầy đủ hoặc số điện thoại hợp lệ.')

export const recipientSchema = z.object({
  authUserId: z.uuid(),
  maskedName: z.string().trim().min(1).max(200)
})
export type Recipient = z.infer<typeof recipientSchema>

// Retry-After can be seconds or an HTTP date. Missing/inaccessible headers use
// the backend's documented 60-second lookup window.
export function lookupRetryAt(header: unknown, now = Date.now()): number {
  if (typeof header !== 'string' && typeof header !== 'number') return now + 60_000
  const value = String(header).trim()
  if (!value) return now + 60_000
  const seconds = /^\d+$/.test(value) ? Number(value) : NaN
  const deadline = Number.isFinite(seconds) ? now + seconds * 1000 : Date.parse(value)
  return Number.isFinite(deadline) && deadline > now ? deadline : now + 60_000
}
</file>

