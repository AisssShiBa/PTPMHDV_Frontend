                </div>
              </div>

              {/* Lý do điều chỉnh & Mã tham chiếu (Bắt buộc) */}
              <div className="space-y-1.5">
                <div className="flex items-center justify-between">
                  <Label htmlFor="reasonArea" className="text-xs font-semibold text-muted-foreground">
