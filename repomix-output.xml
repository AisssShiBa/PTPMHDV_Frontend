  kycStatus: 'PENDING',
  kycTier: 0,
  idNumber: null,
  idImageUrl: null,
  createdAt: '2026-11-10T10:00:00.000Z',
  updatedAt: '2026-11-10T10:00:00.000Z'
}

const topup: AdminTopup = {
  id: topupId,
  userId,
  amount: '100000.00',
  code: 'TOPUP-1',
  status: 'PENDING',
  expiresAt: '2026-11-12T10:00:00.000Z',
  approvedBy: null,
  approvedAt: null,
  rejectReason: null,
  walletTransactionId: null,
  vnpTransactionNo: null,
  vnpBankCode: null,
  vnpPayDate: null,
  vnpResponseCode: null,
  paymentUrl: null,
