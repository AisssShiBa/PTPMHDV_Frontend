    handleMarkItemAsRead(id)
    if (isMe) {
      toast.success('Đã xác nhận thiết bị tin cậy')
    } else {
      toast.error('Đã ghi nhận yêu cầu bảo vệ tài khoản! Phiên đăng nhập lạ đã bị đăng xuất.')
    }
  }

