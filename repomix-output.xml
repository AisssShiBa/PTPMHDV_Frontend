            <span>Đặt lại bộ lọc</span>
          </Button>
        </Card>
      )}

      {/* ======================================================== */}
      {/* DIALOG CHI TIẾT BIÊN LAI ĐIỆN TỬ (RECEIPT MODAL)         */}
