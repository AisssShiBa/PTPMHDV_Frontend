  it('không crash khi backend trả loại thông báo mới chưa khai báo', () => {
    renderWithProviders(
      <NotificationListItem
        notification={notification({ type: 'SOMETHING_NEW' as NotificationItem['type'] })}
        onMarkRead={() => {}}
