<body class="bg-background text-on-surface font-body-md text-body-md antialiased min-h-screen flex flex-col justify-between selection:bg-primary-fixed selection:text-on-primary-fixed">
<!-- TOP MINIMAL NAVIGATION BAR -->
<header class="w-full max-w-[1440px] mx-auto px-6 lg:px-12 py-6 flex items-center justify-between">
<!-- Brand Anchor -->
<a class="flex items-center gap-3 group" href="#">
<div class="w-10 h-10 rounded-xl bg-primary text-on-primary flex items-center justify-center shadow-sm group-hover:bg-primary-container transition-colors">
<span class="material-symbols-outlined text-[24px]">account_balance_wallet</span>
</div>
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-on-surface tracking-tight leading-tight">FinVault</span>
<span class="font-label-sm text-label-sm text-on-surface-variant font-normal">Ví điện tử cá nhân</span>
</div>
</a>
<!-- Top Right Meta & Status -->
<div class="flex items-center gap-5">
<!-- Security Badge -->
<div class="hidden sm:flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-surface-container-lowest border border-outline-variant/30 text-on-surface-variant font-label-md text-label-md">
<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
<span>Bảo mật bằng mã PIN và xác thực hai lớp</span>
</div>
<!-- Language Selector -->
<button class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-outline-variant/40 bg-surface-container-lowest hover:bg-surface-container-low text-on-surface font-label-md text-label-md transition-colors" type="button">
<span class="material-symbols-outlined text-[18px] text-secondary">language</span>
<span>Tiếng Việt</span>
<span class="material-symbols-outlined text-[16px] text-secondary">expand_more</span>
</button>
</div>
</header>
<!-- MAIN REGISTRATION SECTION -->
<main class="flex-grow flex items-center justify-center px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
<div class="w-full max-w-[1140px] bg-surface-container-lowest rounded-[20px] border border-outline-variant/30 card-ambient-shadow overflow-hidden grid grid-cols-1 lg:grid-cols-12">
<!-- CỘT TRÁI: FORM ĐĂNG KÝ (7 COLS ON DESKTOP) -->
<div class="lg:col-span-7 p-6 sm:p-10 lg:p-12 flex flex-col justify-between">
<div>
<!-- Header Cột Trái -->
<div class="mb-7">
<h1 class="font-headline-lg text-headline-lg text-on-surface font-bold tracking-tight mb-2">
              Tạo tài khoản FinVault
            </h1>
<p class="font-body-md text-body-md text-on-surface-variant">
              Mở ví trong vài phút, nâng hạn mức khi bạn xác minh danh tính.
            </p>
</div>
<!-- Form Fields Container -->
<form class="space-y-4" onsubmit="event.preventDefault();">
<!-- Họ và tên -->
<div>
<label class="block font-label-md text-label-md text-on-surface mb-1.5 font-semibold" for="fullName">
                Họ và tên
              </label>
<div class="relative flex items-center">
<span class="absolute left-3.5 material-symbols-outlined text-[20px] text-secondary pointer-events-none">
                  person
                </span>
<input class="w-full h-12 pl-11 pr-4 rounded-[10px] bg-surface-container-lowest border border-outline-variant/50 text-on-surface font-body-md text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-none" id="fullName" name="fullName" placeholder="Ví dụ: Nguyễn Văn An" type="text" value="Nguyễn Văn An"/>
</div>
</div>
<!-- Email & Feedback -->
<div>
<label class="block font-label-md text-label-md text-on-surface mb-1.5 font-semibold" for="email">
                Email
              </label>
<div class="relative flex items-center">
<span class="absolute left-3.5 material-symbols-outlined text-[20px] text-secondary pointer-events-none">
                  mail
                </span>
<input class="w-full h-12 pl-11 pr-4 rounded-[10px] bg-surface-container-lowest border border-outline-variant/50 text-on-surface font-body-md text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-none" id="email" name="email" placeholder="nguyen.an@finvault.vn" type="email" value="an.nguyen@email.com"/>
</div>
<p class="mt-1.5 font-body-sm text-body-sm text-secondary flex items-center gap-1.5">
<span class="material-symbols-outlined text-[15px] text-primary">info</span>
<span>Email sẽ được dùng để nhận biên lai điện tử và đặt lại mã PIN.</span>
</p>
</div>
<!-- Số điện thoại -->
<div>
<label class="block font-label-md text-label-md text-on-surface mb-1.5 font-semibold" for="phone">
                Số điện thoại
              </label>
<div class="relative flex items-center">
<span class="absolute left-3.5 material-symbols-outlined text-[20px] text-secondary pointer-events-none">
                  call
                </span>
<input class="w-full h-12 pl-11 pr-4 rounded-[10px] bg-surface-container-lowest border border-outline-variant/50 text-on-surface font-body-md text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-none" id="phone" name="phone" placeholder="0909 123 456" type="tel" value="0909 888 999"/>
</div>
</div>
<!-- Mật khẩu & Strength Meter -->
<div>
<label class="block font-label-md text-label-md text-on-surface mb-1.5 font-semibold" for="password">
                Mật khẩu
              </label>
<div class="relative flex items-center">
<span class="absolute left-3.5 material-symbols-outlined text-[20px] text-secondary pointer-events-none">
                  lock
                </span>
<input class="w-full h-12 pl-11 pr-11 rounded-[10px] bg-surface-container-lowest border border-outline-variant/50 text-on-surface font-body-md text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all outline-none" id="password" name="password" placeholder="Nhập ít nhất 8 ký tự..." type="password" value="FinVault#2025!"/>
<button class="absolute right-3.5 text-secondary hover:text-on-surface transition-colors flex items-center" type="button">
<span class="material-symbols-outlined text-[20px]">visibility</span>
</button>
</div>
<!-- Password Strength Meter -->
<div class="mt-2 space-y-1.5">
<div class="flex items-center gap-1.5 w-full">
<div class="h-1.5 flex-1 rounded-full bg-primary transition-all"></div>
<div class="h-1.5 flex-1 rounded-full bg-primary transition-all"></div>
<div class="h-1.5 flex-1 rounded-full bg-primary transition-all"></div>
<div class="h-1.5 flex-1 rounded-full bg-outline-variant/40 transition-all"></div>
</div>
<div class="flex items-center justify-between text-body-sm font-body-sm">
<span class="text-primary font-semibold font-label-sm text-label-sm">Độ mạnh: Khá tốt</span>
<span class="text-on-surface-variant font-label-sm text-label-sm">Cần ít nhất 8 ký tự, gồm chữ và số</span>
</div>
</div>
</div>
<!-- Nhập lại mật khẩu -->
<div>
<label class="block font-label-md text-label-md text-on-surface mb-1.5 font-semibold" for="confirmPassword">
                Nhập lại mật khẩu
              </label>
<div class="relative flex items-center">
<span class="absolute left-3.5 material-symbols-outlined text-[20px] text-secondary pointer-events-none">
                  lock_reset
                </span>
