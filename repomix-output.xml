                type="submit"
                className="w-full h-11 text-xs sm:text-sm font-bold gap-2 shadow-xs cursor-pointer"
              >
                <FileCheck className="h-4 w-4" />
                <span>Ký duyệt & Tạo bút toán</span>
              </Button>
            </form>
          </CardContent>
        </Card>
      </div>
    </div>
  )
}

