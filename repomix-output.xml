                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "authUserId",
                        "maskedName"
                      ],
                      "properties": {
                        "authUserId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "maskedName": {
                          "type": "string",
