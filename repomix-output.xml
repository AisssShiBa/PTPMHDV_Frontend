<td class="py-4 px-5 text-right whitespace-nowrap">
<button class="px-3.5 py-2 rounded-xl bg-primary/10 hover:bg-primary/20 text-primary font-semibold text-[13px] border border-primary/20 transition-all inline-flex items-center gap-1.5 active:scale-95" onclick="selectIncident('w_8f3a... (Nguyễn Văn Bình)', '50.000', 'DEBIT')">
<span class="material-symbols-outlined text-[16px]">edit_note</span>
<span>Tạo bút toán điều chỉnh</span>
</button>
</td>
</tr>
