                  <td class="py-5 px-6 font-semibold text-text-main">
                    <div class="flex items-center gap-2">
                      <span class="material-symbols-outlined text-[20px] text-text-muted">calendar_today</span>
                      <span>Tối đa mỗi ngày</span>
                    </div>
                  </td>
                  <td class="py-5 px-6 font-medium text-text-main border-l border-slate-200">
                    500.000đ
                  </td>
                  <td class="py-5 px-6 font-medium text-text-main border-l border-slate-200">
                    20.000.000đ
                  </td>
                  <td class="py-5 px-6 font-bold text-primary border-l border-slate-200 bg-primary-light/20">
                    100.000.000đ
                  </td>
                </tr>

                <!-- Hàng 3: Tối đa mỗi tháng -->
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="py-5 px-6 font-semibold text-text-main">
                    <div class="flex items-center gap-2">
                      <span class="material-symbols-outlined text-[20px] text-text-muted">date_range</span>
                      <span>Tối đa mỗi tháng</span>
                    </div>
                  </td>
                  <td class="py-5 px-6 font-medium text-text-main border-l border-slate-200">
