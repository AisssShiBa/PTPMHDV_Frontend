                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 text-[15px]">
                
                <!-- Hàng 1: Tối đa mỗi lần -->
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="py-5 px-6 font-semibold text-text-main">
                    <div class="flex items-center gap-2">
                      <span class="material-symbols-outlined text-[20px] text-text-muted">payments</span>
                      <span>Tối đa mỗi lần</span>
