<script>
  // Toggle Password Visibility
  function togglePasswordVisibility() {
    const pwdInput = document.getElementById('account-pwd');
    const icon = document.getElementById('pwd-icon');
    if (pwdInput.type === 'password') {
      pwdInput.type = 'text';
      icon.innerText = 'visibility_off';
    } else {
      pwdInput.type = 'password';
      icon.innerText = 'visibility';
    }
  }

  // QR Countdown and State Simulator
  let timeLeft = 120; // 2 minutes
  let isExpired = false;
  let timerInterval = null;

  function startTimer() {
    if (timerInterval) clearInterval(timerInterval);
    timerInterval = setInterval(() => {
      if (timeLeft <= 0) {
        clearInterval(timerInterval);
        setExpiredState(true);
      } else {
        timeLeft--;
        updateTimerDisplay();
      }
    }, 1000);
  }

  function updateTimerDisplay() {
    const minutes = Math.floor(timeLeft / 60).toString().padStart(2, '0');
    const seconds = (timeLeft % 60).toString().padStart(2, '0');
    const display = document.getElementById('qr-countdown');
    if (display) {
      display.innerText = `${minutes}:${seconds}`;
    }
  }

  function setExpiredState(expired) {
    isExpired = expired;
    const overlay = document.getElementById('qr-expired-overlay');
    const scanLine = document.getElementById('qr-scan-line');
    const toggleLabel = document.getElementById('demo-toggle-label');

    if (expired) {
      overlay.classList.remove('hidden');
      scanLine.classList.add('hidden');
      if (toggleLabel) toggleLabel.innerText = 'Xem mã QR hợp lệ';
    } else {
      overlay.classList.add('hidden');
      scanLine.classList.remove('hidden');
      if (toggleLabel) toggleLabel.innerText = 'Thử xem trạng thái hết hạn';
    }
  }

  function toggleQrExpiredState() {
    if (isExpired) {
      refreshQrCode();
    } else {
      timeLeft = 0;
      updateTimerDisplay();
      setExpiredState(true);
    }
  }

  function refreshQrCode() {
    timeLeft = 120;
    updateTimerDisplay();
    setExpiredState(false);
    startTimer();
    
    // Quick reload pulse feedback
    const wrapper = document.getElementById('qr-wrapper');
    wrapper.classList.add('scale-95');
    setTimeout(() => wrapper.classList.remove('scale-95'), 180);
  }

  // Initialize
  startTimer();
</script>
</body></html>
