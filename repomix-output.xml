ken)\n        .catch((error: unknown) => {\n          storageError = error instanceof Error ? error : new Error('Không thể lưu phiên đăng nhập an toàn.')\n        })\n    }\n  },\n  clear: () => {\n    accessToken = null\n    refreshToken = null\n    userId = null\n    storageError = null\n    persistRefreshToken = SecureStore.deleteItemAsync(refreshTokenKey)\n      .catch((error: unknown) => {\n        storageError = error instanceof Error ? error : new Error('Không thể xóa phiên đăng nhập an toàn.')\n      })\n  }\n}\n\nconst api = createApiClient({\n  baseURL,\n  platform: 'mobile',\n  tokenStore,\n  onSessionExpired: () => sessionExpiredHandler?.()\n})\n\nfunction toVietnameseError(error: unknown): string {\n  if (error instanceof ApiError) return error.message\n  return 'Không thể kết nối máy chủ. Vui lòng thử lại.'\n}\n\nexport default function App() {\n  const [session, setSession] = useState<MobileSession | null>(null)\n  const [username, setUsername] = useState('')\n  const [password, setPassword] = useState('')\n  const [errorMessage, setErrorMessage] = useState('')\n  const [unreadCount, setUnreadCount] = useState<number | null>(null)\n  const [loading, setLoading] = useState(true)\n  const [submitting, setSubmitting] = useState(false)\n  const [retryRestore, setRetryRestore] = useState(false)\n  const mountedRef = useRef(true)\n\n  const restoreSession = useCallback(async () => {\n    setLoading(true)\n    setErrorMessage('')\n    setRetryRestore(false)\n    try {\n      const storedRefreshToken = await SecureStore.getItemAsync(refreshTokenKey)\n      if (!storedRefreshToken) return\n      refreshToken = storedRefreshToken\n      const restored = await api.auth.refresh<MobileSession>()\n      await persistRefreshToken\n      if (storageError) throw storageError\n      if (mountedRef.current) setSession(restored)\n    } catch (error) {\n      const expired = error instanceof ApiError && error.code === 'SESSION_EXPIRED'\n      if (expired) {\n        tokenStore.clear()\n        await persistRefreshToken\n      }\n      if (mountedRef.current) {\n        setSession(null)\n        setErrorMessage(expired\n          ? 'Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.'\n          : 'Không thể kết nối máy chủ. Vui lòng thử lại.')\n        setRetryRestore(!expired)\n      }\n    } finally {\n      if (mountedRef.current) setLoading(false)\n    }\n  }, [])\n\n  useEffect(() => {\n    mountedRef.current = true\n    sessionExpiredHandler = () => {\n      setSession(null)\n      setErrorMessage('Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.')\n      setRetryRestore(false)\n    }\n\n    void restoreSession()\n    return () => {\n      mountedRef.current = false\n      sessionExpiredHandler = undefined\n    }\n  }, [restoreSession])\n\n  useEffect(() => {\n    if (!session) {\n      setUnreadCount(null)\n      return\n    }\n\n    let active = true\n    void api.notifications.list<NotificationList>()\n      .then((result) => {\n        if (active) setUnreadCount(result.unreadCount)\n      })\n      .catch((error: unknown) => {\n        if (active) setErrorMessage(toVietnameseError(error))\n      })\n\n    return () => {\n      active = false\n    }\n  }, [session])\n\n  const signIn = async () => {\n    setSubmitting(true)\n    setErrorMessage('')\n    setRetryRestore(false)\n    try {\n      const signedIn = await api.auth.signIn<MobileSession>({ username, password })\n      await persistRefreshToken\n      if (storageError) throw storageError\n      setSession(signedIn)\n      setPassword('')\n    } catch (error) {\n      const message = storageError?.message ?? toVietnameseError(error)\n      if (storageError) {\n        tokenStore.clear()\n        await persistRefreshToken\n      }\n      setErrorMessage(message)\n    } finally {\n      setSubmitting(false)\n    }\n  }\n\n  const signOut = async () => {\n    setErrorMessage('')\n    try {\n      await api.auth.signOut()\n      await persistRefreshToken\n      if (storageError) throw storageError\n      setSession(null)\n    } catch (error) {\n      await persistRefreshToken\n      setErrorMessage(storageError?.message ?? toVietnameseError(error))\n      setSession(null)\n    }\n  }\n\n  if (loading) {\n    return (\n      <SafeAreaView style={styles.container}>\n        <ActivityIndicator size=\"large\" />\n        <Text style={styles.muted}>Đang khôi phục phiên đăng nhập...</Text>\n      </SafeAreaView>\n    )\n  }\n\n  if (session) {\n    return (\n      <SafeAreaView style={styles.container}>\n        <View style={styles.card}>\n          <Text style={styles.title}>Xin chào {session.user.firstName || session.user.id}</Text>\n          <Text style={styles.body}>\n            Thông báo chưa đọc: {unreadCount === null ? 'Đang tải...' : unreadCount}\n          </Text>\n          {errorMessage ? <Text style={styles.error}>{errorMessage}</Text> : null}\n          <TouchableOpacity style={styles.button} onPress={() => void signOut()}>\n            <Text style={styles.buttonText}>Đăng xuất</Text>\n          </TouchableOpacity>\n        </View>\n      </SafeAreaView>\n    )\n  }\n\n  return (\n    <SafeAreaView style={styles.container}>\n      <View style={styles.card}>\n        <Text style={styles.title}>Đăng nhập FinVault</Text>\n        <TextInput\n          autoCapitalize=\"none\"\n          autoCorrect={false}\n          onChangeText={setUsername}\n          placeholder=\"Tên đăng nhập\"\n          style={styles.input}\n          value={username}\n        />\n        <TextInput\n          onChangeText={setPassword}\n          placeholder=\"Mật khẩu\"\n          secureTextEntry\n          style={styles.input}\n          value={password}\n        />\n        {errorMessage ? <Text style={styles.error}>{errorMessage}</Text> : null}\n        {retryRestore ? (\n          <TouchableOpacity\n            disabled={loading}\n            onPress={() => void restoreSession()}\n            style={[styles.button, loading && styles.disabled]}\n          >\n            <Text style={styles.buttonText}>{loading ? 'Đang thử lại...' : 'Thử lại'}</Text>\n          </TouchableOpacity>\n        ) : null}\n        <TouchableOpacity\n          disabled={submitting || !username || !password}\n          onPress={() => void signIn()}\n          style={[styles.button, (submitting || !username || !password) && styles.disabled]}\n        >\n          <Text style={styles.buttonText}>{submitting ? 'Đang đăng nhập...' : 'Đăng nhập'}</Text>\n        </TouchableOpacity>\n        <Text style={styles.muted}>{useMock ? 'Đang dùng mock API' : 'Kết nối Gateway'}</Text>\n      </View>\n    </SafeAreaView>\n  )\n}\n\nconst styles = StyleSheet.create({\n  container: {\n    alignItems: 'center',\n    backgroundColor: '#f4f7fb',\n    flex: 1,\n    justifyContent: 'center',\n    padding: 24\n  },\n  card: {\n    backgroundColor: '#ffffff',\n    borderRadius: 16,\n    gap: 16,\n    maxWidth: 440,\n    padding: 24,\n    width: '100%'\n  },\n  title: {\n    color: '#14243a',\n    fontSize: 24,\n    fontWeight: '700'\n  },\n  body: {\n    color: '#334155',\n    fontSize: 17\n  },\n  input: {\n    borderColor: '#cbd5e1',\n    borderRadius: 8,\n    borderWidth: 1,\n    fontSize: 16,\n    padding: 12\n  },\n  button: {\n    alignItems: 'center',\n    backgroundColor: '#1456c0',\n    borderRadius: 8,\n    padding: 14\n  },\n  disabled: {\n    opacity: 0.5\n  },\n  buttonText: {\n    color: '#ffffff',\n    fontSize: 16,\n    fontWeight: '600'\n  },\n  error: {\n    color: '#b42318'\n  },\n  muted: {\n    color: '#64748b',\n    textAlign: 'center'\n  }\n})\n","usedDeprecatedRules":[]},{"filePath":"/tmp/huu-fe-baseline-ec9e776/apps/mobile/app.config.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/tmp/huu-fe-baseline-ec9e776/apps/mobile/index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":