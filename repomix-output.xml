                        ? 'bg-amber-500/5 border-amber-500/30'
                        : 'bg-primary/5 border-primary/20 shadow-xs'
                    }`}
                  >
                    {!item.isRead && (
                      <div className="absolute top-0 left-0 bottom-0 w-1 bg-primary" />
