import { z } from 'zod'
import api from '@/lib/axios'
import {
  topupSchema,
  topupInputSchema,
  createdTopupSchema,
} from '../schemas/topup.schema'
import { cashoutInputSchema, cashoutSchema } from '../schemas/cashout.schema'
import type { CashOutInput } from '../types/funding.types'
import { FundingError, fundingError } from './funding.errors'
async function read<T>(
  request: () => Promise<{ data: unknown }>,
  schema: z.ZodType<T>,
): Promise<T> {
  try {
    const response = await request()
    return z
      .object({ success: z.literal(true), data: schema })
      .parse(response.data).data
  } catch (error) {
    throw fundingError(error)
  }
}
const orderId = (id: string) => validate(z.uuid(), id)
export function validate<T>(schema: z.ZodType<T>, input: unknown): T {
  const result = schema.safeParse(input)
  if (!result.success) throw new FundingError('HTTP_400')
  return result.data
}
const keyHeader = (key: string) => ({
  'Idempotency-Key': validate(z.uuid(), key),
})
export const fundingApi = {
  createTopup: async (amount: string, key: string) => {
    const payload = validate(topupInputSchema, { amount })
    return read(
      () =>
        api.post('/payments/topups', payload, {
          headers: keyHeader(key),
          fundingNoReplay: true,
        }),
      createdTopupSchema,
    )
  },
  getTopup: (id: string, signal?: AbortSignal) =>
    read(
      () => api.get(`/payments/topups/${orderId(id)}`, { signal }),
      topupSchema,
    ),
  getTopups: (signal?: AbortSignal) =>
    read(() => api.get('/payments/topups', { signal }), z.array(topupSchema)),
  createCashOut: (input: CashOutInput, key: string) =>
    read(
      () =>
        api.post('/funding/cash-out', validate(cashoutInputSchema, input), {
          headers: keyHeader(key),
          fundingNoReplay: true,
        }),
      cashoutSchema,
    ),
  getCashOut: (id: string, signal?: AbortSignal) =>
    read(
      () => api.get(`/funding/cash-out/${orderId(id)}`, { signal }),
      cashoutSchema,
    ),
  confirmCashOut: (id: string, transactionToken: string) =>
    read(
      () =>
        api.post(
          `/funding/cash-out/${orderId(id)}/confirm`,
          {},
          {
            headers: { 'X-Transaction-Token': transactionToken },
            fundingNoReplay: true,
          },
        ),
      cashoutSchema,
    ),
}
</file>

<file path="src/features/funding/api/funding.errors.ts">
import axios from 'axios'
export class FundingError extends Error {
  readonly code: string
  readonly outcomeUnknown: boolean
  readonly requestId?: string
  constructor(code: string, outcomeUnknown = false, requestId?: string) {
    super(
      'Không thể hoàn tất yêu cầu giao dịch. Vui lòng kiểm tra trạng thái trước khi thử lại.',
    )
    this.name = 'FundingError'
    this.code = code
    this.outcomeUnknown = outcomeUnknown
    this.requestId = requestId
  }
}
export function fundingError(error: unknown): FundingError {
  if (error instanceof FundingError) return error
  if (!axios.isAxiosError(error))
    return new FundingError('INVALID_RESPONSE', true)
  const status = error.response?.status
  const body = error.response?.data as
    | { error?: { code?: unknown; traceId?: unknown }; requestId?: unknown }
    | undefined
  const rawCode = body?.error?.code
  const code =
    typeof rawCode === 'string' && /^[A-Z0-9_]{1,100}$/.test(rawCode)
      ? rawCode
      : status
        ? `HTTP_${status}`
        : error.code === 'ECONNABORTED'
          ? 'FUNDING_TIMEOUT'
          : 'FUNDING_NETWORK'
  const rawId =
    body?.error?.traceId ??
    body?.requestId ??
    error.response?.headers?.['x-request-id']
  const requestId =
    typeof rawId === 'string' && /^[a-zA-Z0-9_.:-]{1,128}$/.test(rawId)
      ? rawId
      : undefined
  return new FundingError(code, !status || status >= 500, requestId)
}
</file>

<file path="src/features/funding/api/funding.queries.ts">
import { useEffect } from 'react'
import { queryOptions, useQuery, useQueryClient } from '@tanstack/react-query'
import { useAuthStore } from '@/features/auth'
import { walletKeys } from '@/features/wallet'
import { fundingError, FundingError } from './funding.errors'
import { fundingApi } from './funding.api'
import { isCashOutTerminal, isTopupTerminal } from '../types/funding.types'
export const fundingKeys = {
  all: (owner: string) => ['funding', owner] as const,
  topup: (owner: string, id: string) =>
    ['funding', owner, 'topup', id] as const,
  cashout: (owner: string, id: string) =>
    ['funding', owner, 'cashout', id] as const,
  history: (owner: string) => ['funding', owner, 'topups'] as const,
}
export const fundingQueries = {
  topup: (owner: string, id: string) =>
    queryOptions({
      queryKey: fundingKeys.topup(owner, id),
      queryFn: ({ signal }) => fundingApi.getTopup(id, signal),
      enabled: Boolean(owner && id),
      gcTime: 0,
      retry: false,
    }),
  cashout: (owner: string, id: string) =>
    queryOptions({
      queryKey: fundingKeys.cashout(owner, id),
      queryFn: async ({ signal }) => {
        const order = await fundingApi.getCashOut(id, signal)
        if (order.userId !== owner) throw new FundingError('FORBIDDEN')
        return order
      },
      enabled: Boolean(owner && id),
      gcTime: 0,
      retry: false,
    }),
  history: (owner: string) =>
    queryOptions({
      queryKey: fundingKeys.history(owner),
      queryFn: ({ signal }) => fundingApi.getTopups(signal),
      enabled: Boolean(owner),
      gcTime: 0,
      retry: false,
    }),
}
// A read budget stops polling; it never changes a server status to FAILED/EXPIRED.
export function useTopupStatus(id: string, enabled = true) {
  const owner = useAuthStore((state) => state.user?.id) ?? ''
  const client = useQueryClient()
  const query = useQuery({
    ...fundingQueries.topup(owner, id),
    enabled: Boolean(owner && id && enabled),
    refetchInterval: (q) =>
      q.state.error ||
      (q.state.data && isTopupTerminal(q.state.data.status)) ||
      q.state.dataUpdateCount >= 24
        ? false
        : 5000,
  })
  useEffect(() => {
    if (query.data && isTopupTerminal(query.data.status)) {
      void client.invalidateQueries({ queryKey: walletKeys.all })
      void client.invalidateQueries({ queryKey: fundingKeys.history(owner) })
    }
  }, [client, owner, query.data])
  return query
}
export function useCashOutStatus(id: string) {
  const owner = useAuthStore((state) => state.user?.id) ?? ''
  const client = useQueryClient()
  const query = useQuery({
    ...fundingQueries.cashout(owner, id),
    refetchInterval: (q) =>
      (q.state.error &&
        ![
          'CASHOUT_PROCESSING',
          'CASHOUT_PAYOUT_PENDING',
          'FUNDING_TIMEOUT',
          'FUNDING_NETWORK',
          'HTTP_503',
        ].includes(fundingError(q.state.error).code)) ||
      (q.state.data && isCashOutTerminal(q.state.data.status)) ||
      q.state.dataUpdateCount + q.state.errorUpdateCount >= 24
        ? false
        : Math.min(
            30000,
            3000 *
              2 **
                Math.min(4, q.state.dataUpdateCount + q.state.errorUpdateCount),
          ),
  })
  useEffect(() => {
    if (query.data)
      void client.invalidateQueries({ queryKey: walletKeys.all })
  }, [client, owner, query.data])
  return query
}
