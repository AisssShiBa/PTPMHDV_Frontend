<file path="src/features/admin/components/AdminKycDocumentsViewer.tsx">
import { useEffect, useRef, useState } from 'react'
import { Button } from '@/components/ui/button'
import { errorMessage } from '@/lib/apiResponse'
import { adminService } from '../services/adminService'
import type { AdminKycDocuments } from '../types/admin.types'

export function AdminKycDocumentsViewer({ userId }: { userId: string }) {
  const [documents, setDocuments] = useState<AdminKycDocuments | null>(null)
  const [error, setError] = useState('')
  const [loading, setLoading] = useState(false)
  const request = useRef<AbortController | null>(null)
  const expiry = useRef<ReturnType<typeof setTimeout> | undefined>(undefined)
  useEffect(() => () => { request.current?.abort(); clearTimeout(expiry.current) }, [userId])
  const open = async () => {
    if (request.current && !request.current.signal.aborted) return
    const controller = new AbortController()
    request.current = controller
    clearTimeout(expiry.current)
    setLoading(true); setError(''); setDocuments(null)
    try {
      const data = await adminService.getKycDocuments(userId, controller.signal)
      if (controller.signal.aborted) return
      const remaining = Date.parse(data.expiresAt) - Date.now()
      if (!Number.isFinite(remaining) || remaining <= 0 || remaining > 2147483647 ||
        ![data.frontUrl, data.backUrl].every((url) => ['http:', 'https:'].includes(new URL(url).protocol))) {
        throw new Error('Invalid document response')
      }
      setDocuments(data)
      expiry.current = setTimeout(() => {
        setDocuments(null)
        setError('Liên kết xem ảnh đã hết hạn. Vui lòng tải lại ảnh.')
      }, remaining)
    } catch (reason) {
      if (!controller.signal.aborted) setError(errorMessage(reason))
    } finally {
      if (!controller.signal.aborted) { setLoading(false); request.current = null }
    }
  }
  return <section aria-label="Ảnh hồ sơ KYC" className="space-y-3">
    <div className="flex flex-wrap items-center gap-3">
      <Button type="button" variant="outline" disabled={loading} onClick={() => void open()}>
        {loading ? 'Đang tải ảnh…' : documents ? 'Tải lại ảnh CCCD' : 'Xem hai mặt CCCD'}
      </Button>
      <p className="text-xs text-muted-foreground">Mỗi lần tải ảnh được ghi vào nhật ký kiểm toán.</p>
    </div>
    {error && <p role="alert" className="text-sm text-destructive">{error}</p>}
    {documents && <>
      <div className="grid gap-4 sm:grid-cols-2">
        {(['frontUrl', 'backUrl'] as const).map((side) => <figure key={side} className="space-y-2">
          <figcaption className="text-sm font-semibold">{side === 'frontUrl' ? 'Mặt trước' : 'Mặt sau'}</figcaption>
          <img src={documents[side]} alt={side === 'frontUrl' ? 'CCCD mặt trước' : 'CCCD mặt sau'} referrerPolicy="no-referrer"
            className="h-64 w-full rounded-xl border border-border bg-muted/30 object-contain"
            onError={() => { setDocuments(null); clearTimeout(expiry.current); setError('Không tải được ảnh. Vui lòng tải lại ảnh CCCD.') }} />
        </figure>)}
      </div>
      <p className="text-xs text-muted-foreground">Ảnh có hiệu lực đến {new Date(documents.expiresAt).toLocaleTimeString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' })} (giờ Việt Nam).</p>
      <Button type="button" variant="ghost" onClick={() => { setDocuments(null); clearTimeout(expiry.current) }}>Ẩn ảnh CCCD</Button>
    </>}
  </section>
}
</file>

<file path="src/features/admin/components/KycActionForm.tsx">
import { useRef, useState } from 'react'
import { toast } from 'sonner'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { errorMessage } from '@/lib/apiResponse'
import { useAuthStore } from '@/features/auth/stores/useAuthStore'
import { adminService } from '../services/adminService'
import type { AdminKycItem } from '../types/admin.types'

export type KycAction = 'APPROVED' | 'REJECTED' | 1 | 2

export function KycActionForm({ item, action, onBusy, onSaved }: {
  item: AdminKycItem; action: KycAction; onBusy: (busy: boolean) => void; onSaved: () => void
}) {
  const lock = useRef(false)
  const [reason, setReason] = useState('')
  const [error, setError] = useState('')
  const [submitting, setSubmitting] = useState(false)
  const [needsReload, setNeedsReload] = useState(false)
  const description = action === 'APPROVED' ? 'Duyệt hồ sơ và đặt cấp KYC về 1.'
    : action === 'REJECTED' ? 'Từ chối hồ sơ và đưa cấp KYC về 0. Người dùng cần nộp lại giấy tờ.'
    : action === 2 ? 'Nâng cấp 2 (mô phỏng liên kết ngân hàng).'
    : 'Đặt cấp KYC về 1; hồ sơ vẫn ở trạng thái đã xác thực.'
  const submit = async () => {
    if (lock.current || needsReload) return
    const detail = reason.trim()
    if (!detail || detail.length > 500) { setError('Vui lòng nhập lý do từ 1 đến 500 ký tự.'); return }
    lock.current = true; setSubmitting(true); onBusy(true); setError('')
    const adminId = useAuthStore.getState().user?.id
    let failed = false
    try {
      const result = typeof action === 'number'
        ? await adminService.updateKycTier(item.id, action, detail)
        : await adminService.reviewKyc(item.id, action, detail)
      if (useAuthStore.getState().user?.id !== adminId) return
      toast.success(`Đã cập nhật hồ sơ: cấp KYC ${result.kycTier}.`)
      onSaved()
    } catch (failure) {
      if (useAuthStore.getState().user?.id !== adminId) return
      setError(errorMessage(failure))
      setNeedsReload(true)
      failed = true
    } finally { lock.current = false; setSubmitting(false); if (!failed) onBusy(false) }
  }
  return <form className="space-y-3 border-t border-border pt-5" onSubmit={(event) => { event.preventDefault(); void submit() }}>
    <p className="font-semibold">{description}</p>
    <Label htmlFor="kyc-reason">Lý do xét duyệt / đổi cấp</Label>
    <Input id="kyc-reason" value={reason} maxLength={500} disabled={submitting || needsReload} aria-invalid={!!error} aria-describedby="kyc-action-help"
      onChange={(event) => setReason(event.target.value)} placeholder="Nhập lý do để lưu vào nhật ký" />
    <p id="kyc-action-help" className="text-xs text-muted-foreground">Bắt buộc, tối đa 500 ký tự. Không nhập số CCCD đầy đủ vào lý do.</p>
    {error && <p role="alert" className="text-sm text-destructive">{error}</p>}
    {needsReload ? <div className="space-y-2"><p className="text-sm">Tải lại hồ sơ và kiểm tra kết quả trước khi thực hiện tiếp.</p><Button type="button" variant="outline" onClick={onSaved}>Tải lại danh sách</Button></div>
      : <Button type="submit" variant={action === 'REJECTED' ? 'destructive' : 'default'} disabled={submitting}>{submitting ? 'Đang lưu…' : 'Xác nhận cập nhật'}</Button>}
  </form>
}
</file>

