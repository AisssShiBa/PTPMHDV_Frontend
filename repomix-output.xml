<file path="src/features/auth/api/auth.api.ts">
import api from '@/lib/axios'
import { unwrap } from '@/lib/apiResponse'
import type { ApiResponse } from '@/lib/apiResponse'
import type { User, AuthSession } from '../types/auth.types'

export interface SignInPayload {
  username: string
  password: string
  platform?: 'web' | 'mobile'
}

export interface SignUpPayload {
  email: string
  password: string
  username?: string
  firstName?: string
  lastName?: string
}

export interface QrInitResponse {
  qrId: string
  nonce: string
  pollSecret: string
  expiresAt: string
  /** @deprecated Hỗ trợ tương thích ngược cho giao diện cũ */
  sessionId?: string
  /** @deprecated Hỗ trợ tương thích ngược cho giao diện cũ */
  qrToken?: string
}

export interface QrStatusResponse {
  status: 'PENDING' | 'APPROVED' | 'REJECTED' | 'SCANNED' | 'CONFIRMED' | 'EXPIRED'
  accessToken?: string
  user?: User
  expiresAt?: string
}

export interface ConfirmQrPayload {
  qrId: string
  nonce: string
}

export interface VerifyPinPayload {
  pin: string
  paymentId: string
  amount: string | number
}

export interface VerifyPinResponse {
  transactionToken: string
  expiresIn: number
}

export interface PinStatusResponse {
  hasPin: boolean
  isLocked: boolean
  lockedUntil?: string | null
  attemptsRemaining?: number
}

export interface SetupPinPayload {
  pin: string
  confirmPin: string
}

export interface ChangePinPayload {
  oldPin: string
  newPin: string
  confirmNewPin: string
}

export const authApi = {
  /**
   * 1. Đăng nhập hệ thống bằng email hoặc tên đăng nhập
   * Endpoint: POST /api/auth/signin
   */
  async signIn(payload: SignInPayload): Promise<AuthSession> {
    const res = await api.post<ApiResponse<AuthSession>>('/auth/signin', {
      username: payload.username.trim(),
      password: payload.password,
      platform: payload.platform || 'web'
    })
    return unwrap(res.data)
  },

  /**
   * 2. Đăng ký tài khoản người dùng mới
   * Endpoint: POST /api/auth/signup
   */
  async signUp(payload: SignUpPayload): Promise<User> {
    const defaultUsername =
      payload.username ||
      payload.email.split('@')[0].replace(/[^a-zA-Z0-9_]/g, '_').slice(0, 30) ||
      'user'
    const res = await api.post<ApiResponse<{ user: User } | User>>('/auth/signup', {
      email: payload.email.trim(),
      password: payload.password,
      username: defaultUsername,
      firstName: payload.firstName || 'Thành viên',
      lastName: payload.lastName || 'FinVault'
    })
    const data = unwrap(res.data)
    return (data as { user: User }).user || (data as User)
  },

  /**
   * 3. Làm mới Access Token thông qua HTTP-Only cookie refreshToken
   * Endpoint: POST /api/auth/refresh
   */
  async refresh(): Promise<AuthSession> {
    const res = await api.post<ApiResponse<AuthSession>>('/auth/refresh', {})
    return unwrap(res.data)
  },

  /**
   * 4. Đăng xuất tài khoản & xóa cookie phiên làm việc
   * Endpoint: POST /api/auth/signout
   */
  async signOut(): Promise<void> {
    await api.post('/auth/signout', {})
  },

  /**
   * 5. Lấy thông tin chi tiết người dùng hiện tại
   * Endpoint: GET /api/users/me
   */
  async getMe(): Promise<User> {
    const res = await api.get<ApiResponse<User>>('/users/me')
    return unwrap(res.data)
  },

  /**
   * 6. Khởi tạo phiên quét mã QR Đăng nhập (Web)
   * Endpoint: POST /api/auth/qr-login/init
   * Khớp chính xác backend: trả về { qrId, nonce, pollSecret, expiresAt }
   */
  async initQrLogin(): Promise<QrInitResponse> {
    const res = await api.post<ApiResponse<QrInitResponse>>('/auth/qr-login/init', {})
    const data = unwrap(res.data)
    return {
      ...data,
      sessionId: data.qrId,
      qrToken: data.nonce
    }
  },

  /**
   * 7. Polling kiểm tra trạng thái phiên mã QR
   * Endpoint: GET /api/auth/qr-login/:id/status
   * Khớp chính xác backend: gửi pollSecret qua cả query parameter và header x-poll-secret
   */
  async getQrStatus(qrId: string, pollSecret: string): Promise<QrStatusResponse> {
    const res = await api.get<ApiResponse<QrStatusResponse>>(
      `/auth/qr-login/${encodeURIComponent(qrId)}/status`,
      {
        params: { pollSecret },
        headers: { 'x-poll-secret': pollSecret }
      }
    )
    return unwrap(res.data)
  },

  /**
   * 8. Xác nhận đăng nhập QR (Dành cho Mobile hoặc script giả lập)
   * Endpoint: POST /api/auth/qr-login/confirm
   */
  async confirmQrLogin(payload: ConfirmQrPayload): Promise<{ success: boolean }> {
    const res = await api.post<ApiResponse<{ success: boolean }>>('/auth/qr-login/confirm', payload)
    return unwrap(res.data)
  },

  /**
   * 9. Xác thực mã PIN 6 số để nhận transactionToken dùng 1 lần trong 60 giây
   * Endpoint: POST /api/auth/pin/verify
   * paymentId và amount bắt buộc theo verifyPinSchema backend
   */
  async verifyPin(payload: VerifyPinPayload): Promise<VerifyPinResponse> {
    if (!payload.paymentId || !payload.amount) throw new Error('Thiếu thông tin giao dịch cần xác thực.')
    const res = await api.post<ApiResponse<VerifyPinResponse>>('/auth/pin/verify', {
      pin: payload.pin,
      paymentId: payload.paymentId,
      amount: String(payload.amount)
    })
    return unwrap(res.data)
  },

  /**
   * 10. Lấy trạng thái cài đặt & khóa của mã PIN
   * Endpoint: GET /api/auth/pin/status
   */
  async getPinStatus(): Promise<PinStatusResponse> {
    const res = await api.get<ApiResponse<PinStatusResponse>>('/auth/pin/status')
    return unwrap(res.data)
  },

  /**
   * 11. Thiết lập mã PIN lần đầu
   * Endpoint: POST /api/auth/pin/setup
   */
  async setupPin(payload: SetupPinPayload): Promise<{ success: boolean }> {
    const res = await api.post<ApiResponse<{ success: boolean }>>('/auth/pin/setup', payload)
    return unwrap(res.data)
  },

  /**
   * 12. Đổi mã PIN giao dịch
   * Endpoint: POST /api/auth/pin/change
   */
  async changePin(payload: ChangePinPayload): Promise<{ success: boolean }> {
    const res = await api.post<ApiResponse<{ success: boolean }>>('/auth/pin/change', payload)
    return unwrap(res.data)
  }
}

/**
 * Gộp authService cũ vào đây làm một điểm gọi duy nhất (Single Source of Truth)
 */
export const authService = {
  signUp: (username: string, password: string, email: string, firstName: string, lastName: string) =>
    authApi.signUp({ username, password, email, firstName, lastName }),
  signIn: (username: string, password: string) =>
    authApi.signIn({ username, password }),
  signOut: () => authApi.signOut(),
  refresh: () => authApi.refresh()
}

export default authApi
</file>

<file path="src/features/merchant/services/merchantService.ts">
import { z } from 'zod'
import {
  merchantRecordSchema,
  merchantRegisterDtoSchema,
} from '../schemas/merchant.schema'
import { MerchantError } from '../api/merchant.errors'
import api from '@/lib/axios'
import { unwrap, type ApiResponse } from '@/lib/apiResponse'
import type {
  MerchantRecord,
  MerchantRegisterDto,
} from '../types/merchant.types'

export const merchantService = {
  async register(payload: MerchantRegisterDto) {
    return merchantService.registerMerchant(payload)
  },
  async getById(id: string) {
    const res = await api.get<ApiResponse<MerchantRecord>>(
      '/merchants/' + encodeURIComponent(id),
    )
    return unwrap(res.data)
  },
  async checkActive(id: string) {
    const res = await api.get<ApiResponse<{ active: boolean }>>(
      '/merchants/' + encodeURIComponent(id) + '/active',
    )
    return unwrap(res.data)
  },
  async getMerchants() {
    const res = await api.get<ApiResponse<MerchantRecord[]>>('/merchants')
    return unwrap(res.data)
  },
  async getMyMerchant(signal?: AbortSignal, expectedOwner?: string) {
    const res = await api.get<unknown>('/merchants/me', { signal })
    const result = z
      .object({
        success: z.literal(true),
        data: merchantRecordSchema.nullable(),
      })
      .safeParse(res.data)
    if (!result.success) throw new MerchantError('MERCHANT_INVALID_RESPONSE')
    if (
      result.data.data &&
      expectedOwner &&
      result.data.data.ownerId !== expectedOwner
    )
      throw new MerchantError('FORBIDDEN')
    return result.data.data
  },
  async registerMerchant(payload: MerchantRegisterDto, expectedOwner?: string) {
    const input = merchantRegisterDtoSchema.safeParse(payload)
    if (!input.success) throw new MerchantError('MERCHANT_INVALID_INPUT')
    // Registration has an owner uniqueness constraint, not an idempotency contract.
    // Never replay this POST automatically after a 401 or ambiguous response.
    const res = await api.post<unknown>('/merchants/register', input.data, {
      fundingNoReplay: true,
    })
    const result = z
      .object({ success: z.literal(true), data: merchantRecordSchema })
      .safeParse(res.data)
    if (!result.success) throw new MerchantError('MERCHANT_INVALID_RESPONSE')
    if (expectedOwner && result.data.data.ownerId !== expectedOwner)
      throw new MerchantError('FORBIDDEN')
    return result.data.data
  },
}
</file>

<file path="src/features/user/components/KycForm.tsx">
import { useEffect, useRef, useState } from 'react'
import { useForm, useWatch } from 'react-hook-form'
import { zodResolver } from '@hookform/resolvers/zod'
import { toast } from 'sonner'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { Button } from '@/components/ui/button'
import { errorCode, errorMessage } from '@/lib/apiResponse'
import { useAuthStore } from '@/features/auth'
import { kycSchema, MAX_KYC_FILE_SIZE, type KycFormValues } from '../schemas/user.schema'
import { userService } from '../services/userService'
import type { UserProfile } from '../types/user.types'
import { KycDocumentViewer } from './KycDocumentViewer'

export function KycForm({ profile, rejectionReason, onSaved, onReload }: {
  rejectionReason?: string
  profile: UserProfile; onSaved: (profile: UserProfile) => void; onReload: () => Promise<boolean>
}) {
  const busy = useRef(false)
  const [needsReload, setNeedsReload] = useState(false)
  const [reloading, setReloading] = useState(false)
  const reconcile = async () => {
    if (reloading) return
    setReloading(true)
    try {
      if (await onReload()) setNeedsReload(false)
    } finally { setReloading(false) }
  }
  const { register, handleSubmit, control, setValue, setError, formState: { errors, isSubmitting } } = useForm<KycFormValues>({
    resolver: zodResolver(kycSchema), defaultValues: { idNumber: '' }
  })
  const front = useWatch({ control, name: 'front' })
  const back = useWatch({ control, name: 'back' })

  const submit = async (values: KycFormValues) => {
    if (busy.current || needsReload || !['NONE', 'REJECTED'].includes(profile.kycStatus)) return
    busy.current = true
    try {
      const saved = await userService.submitKyc(values)
      if (useAuthStore.getState().user?.id !== profile.authUserId) return
      onSaved(saved)
      toast.success('Đã gửi hồ sơ xác thực, vui lòng chờ xét duyệt.')
    } catch (reason) {
      if (useAuthStore.getState().user?.id !== profile.authUserId) return
      setError('root', { message: errorMessage(reason) })
      // Reload before retrying an upload whose outcome could be ambiguous.
      if (!['INVALID_IMAGE', 'INVALID_UPLOAD', 'KYC_DOCUMENT_REQUIRED', 'KYC_DOCUMENTS_REQUIRED', 'FILE_TOO_LARGE', 'VALIDATION_ERROR'].includes(errorCode(reason) ?? '')) {
        setNeedsReload(true)
      }
    } finally { busy.current = false }
  }
  const canSubmit = profile.kycStatus === 'NONE' || profile.kycStatus === 'REJECTED'
  return <div className="space-y-5">
    {profile.kycStatus === 'PENDING' && <p className="rounded-lg bg-amber-500/10 p-4 text-sm">Hồ sơ đang được xét duyệt. Bạn có thể tải lại trạng thái sau khi có kết quả.</p>}
    {profile.kycStatus === 'APPROVED' && <p className="rounded-lg bg-emerald-500/10 p-4 text-sm">Danh tính của bạn đã được xác thực.</p>}
    {profile.kycStatus === 'REJECTED' && <div className="space-y-2 rounded-lg bg-destructive/10 p-4 text-sm" role="status">
      <p>Hồ sơ chưa được chấp thuận. Vui lòng kiểm tra thông tin và gửi lại ảnh giấy tờ rõ nét.</p>
      {rejectionReason && <p className="break-words"><strong>Lý do từ chối: </strong>{rejectionReason}</p>}
    </div>}
    {canSubmit && <form onSubmit={(event) => { void handleSubmit(submit)(event) }} className="space-y-4" noValidate>
      <div className="space-y-2">
        <Label htmlFor="kyc-number">Số CCCD / Passport</Label>
        <Input id="kyc-number" {...register('idNumber')} disabled={isSubmitting || needsReload}
          autoComplete="off" aria-invalid={!!errors.idNumber} aria-describedby="kyc-number-help" />
        <p id="kyc-number-help" className="text-xs text-muted-foreground">Nhập đúng số trên giấy tờ, tối đa 50 ký tự.</p>
        {errors.idNumber && <p role="alert" className="text-sm text-destructive">{errors.idNumber.message}</p>}
      </div>
      {(['front', 'back'] as const).map((side) => <div key={side} className="space-y-2">
        <Label htmlFor={`kyc-${side}`}>{side === 'front' ? 'Ảnh mặt trước' : 'Ảnh mặt sau'}</Label>
        <Input id={`kyc-${side}`} type="file" accept="image/jpeg,image/png" disabled={isSubmitting || needsReload}
          onChange={(event) => setValue(side, event.target.files?.[0] as File, { shouldValidate: true })}
          aria-invalid={!!errors[side]} aria-describedby={`kyc-${side}-help`} />
        <p id={`kyc-${side}-help`} className="text-xs text-muted-foreground">Ảnh JPEG hoặc PNG, tối đa 5 MiB. Chụp rõ thông tin và không che góc giấy tờ.</p>
        {errors[side] && <p role="alert" className="text-sm text-destructive">{errors[side].message}</p>}
        <ImagePreview file={side === 'front' ? front : back} label={side === 'front' ? 'mặt trước' : 'mặt sau'} />
      </div>)}
      {errors.root && <p role="alert" className="text-sm text-destructive">{errors.root.message}</p>}
      {needsReload
        ? <Button type="button" variant="outline" disabled={reloading} onClick={() => { void reconcile() }}>
          {reloading ? 'Đang tải lại trạng thái…' : 'Tải lại trạng thái hồ sơ'}
        </Button>
        : <Button type="submit" disabled={isSubmitting}>{isSubmitting ? 'Đang gửi hồ sơ…' : 'Gửi xác thực'}</Button>}
    </form>}
    {!canSubmit && <Button variant="outline" disabled={reloading} onClick={() => { void reconcile() }}>Tải lại trạng thái</Button>}
    {profile.hasKycDocument && <KycDocumentViewer key={profile.authUserId + profile.updatedAt} authUserId={profile.authUserId} />}
  </div>
}

function ImagePreview({ file, label }: { file?: File; label: string }) {
  if (!file || !['image/jpeg', 'image/png'].includes(file.type) || !file.size || file.size > MAX_KYC_FILE_SIZE) return null
  return <FilePreview key={[file.name, file.lastModified, file.size, file.type].join(':')} file={file} label={label} />
}

function FilePreview({ file, label }: { file: File; label: string }) {
  const image = useRef<HTMLImageElement>(null)
  const [failed, setFailed] = useState(false)
  useEffect(() => {
    const element = image.current
    if (!element) return
    const url = URL.createObjectURL(file)
    const onError = () => { URL.revokeObjectURL(url); setFailed(true) }
    element.addEventListener('error', onError)
    element.src = url
    return () => {
      element.removeEventListener('error', onError)
      element.removeAttribute('src')
      URL.revokeObjectURL(url)
    }
  }, [file])
  return <>
    {failed && <p role="alert" className="text-sm text-destructive">Không đọc được ảnh {label}. Vui lòng chọn tệp khác.</p>}
    <img ref={image} alt={`Xem trước ${label}`} hidden={failed} className="max-h-64 w-full rounded-lg border border-border object-contain" />
  </>
}
</file>

