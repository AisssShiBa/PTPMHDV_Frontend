vious.data : undefined)\n        : value\n      return { key, status: 'success', data }\n    })\n  }, [key])\n  const current: Resource<T> = state.key === key ? state : { key, status: 'loading' }\n  return { ...current, reload, replace }\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/nguyenhuu/Hoc Tap/HDV/PTPMHDV_Frontend/src/layouts/AdminLayout.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/nguyenhuu/Hoc Tap/HDV/PTPMHDV_Frontend/src/layouts/AuthLayout.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/nguyenhuu/Hoc Tap/HDV/PTPMHDV_Frontend/src/layouts/MainLayout.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/nguyenhuu/Hoc Tap/HDV/PTPMHDV_Frontend/src/lib/apiResponse.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/nguyenhuu/Hoc Tap/HDV/PTPMHDV_Frontend/src/lib/axios.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/nguyenhuu/Hoc Tap/HDV/PTPMHDV_Frontend/src/lib/devState.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/nguyenhuu/Hoc Tap/HDV/PTPMHDV_Frontend/src/lib/fixtureQuery.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/hom