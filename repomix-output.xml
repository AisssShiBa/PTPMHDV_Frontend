              <div className="space-y-2.5">
                {todayList.map((item) => (
                  <Card
                    key={item.id}
                    onClick={() => handleMarkItemAsRead(item.id)}
                    className={`border transition-all cursor-pointer relative overflow-hidden group hover:border-primary/40 ${
                      item.isRead
                        ? 'bg-card border-border/80 opacity-85'
