<label class="flex items-center justify-center gap-2 p-3 rounded-xl border-2 border-primary bg-primary/5 text-primary cursor-pointer text-[13px] font-semibold transition-all">
<input checked="" class="text-primary focus:ring-primary h-4 w-4" name="adjust_type" type="radio" value="DEBIT"/>
<span>Ghi Nợ (Giảm số dư ví)</span>
</label>
<label class="flex items-center justify-center gap-2 p-3 rounded-xl border border-outline-variant/40 hover:bg-surface-container-low text-secondary cursor-pointer text-[13px] font-medium transition-all">
<input class="text-primary focus:ring-primary h-4 w-4" name="adjust_type" type="radio" value="CREDIT"/>
<span>Ghi Có (Tăng số dư ví)</span>
</label>
</div>
</div>
<!-- Số tiền điều chỉnh -->
