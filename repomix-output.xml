    // Tab switching logic
    function switchMainTab(tab) {
      const btnTopup = document.getElementById('tab-btn-topup');
      const btnBills = document.getElementById('tab-btn-bills');
      const contentTopup = document.getElementById('content-tab-topup');
      const contentBills = document.getElementById('content-tab-bills');
      const summaryService = document.getElementById('summary-service-name');
      const summaryDenom = document.getElementById('summary-denom');
      const summaryDiscount = document.getElementById('summary-discount');
      const summaryTotal = document.getElementById('summary-total');
      const btnPayText = document.getElementById('btn-pay-text');

      if (tab === 'topup') {
        // Active Topup
        btnTopup.className = "flex items-center gap-2.5 px-6 py-3 rounded-xl bg-primary text-white font-label-lg text-label-lg shadow-sm transition-all duration-150";
        btnBills.className = "flex items-center gap-2.5 px-6 py-3 rounded-xl bg-white border border-outline-variant/60 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-lowest font-label-lg text-label-lg transition-all duration-150";
        contentTopup.classList.remove('hidden');
        contentBills.classList.add('hidden');

        summaryService.textContent = "Nạp ĐT Viettel (0987345888)";
        summaryDenom.textContent = "100.000đ";
        summaryDiscount.textContent = "-3.000đ";
        summaryTotal.textContent = "97.000đ";
        btnPayText.textContent = "Thanh toán ngay 97.000đ";
      } else {
        // Active Bills
        btnBills.className = "flex items-center gap-2.5 px-6 py-3 rounded-xl bg-primary text-white font-label-lg text-label-lg shadow-sm transition-all duration-150";
        btnTopup.className = "flex items-center gap-2.5 px-6 py-3 rounded-xl bg-white border border-outline-variant/60 text-on-surface-variant hover:text-on-surface hover:bg-surface-container-lowest font-label-lg text-label-lg transition-all duration-150";
        contentBills.classList.remove('hidden');
        contentTopup.classList.add('hidden');

        summaryService.textContent = "Tiền điện sinh hoạt EVN (PE0100028491)";
        summaryDenom.textContent = "420.000đ";
        summaryDiscount.textContent = "-0đ (Không thu phí)";
        summaryTotal.textContent = "420.000đ";
        btnPayText.textContent = "Thanh toán hóa đơn 420.000đ";
      }
      cancelPinStep();
    }

    // Denomination Selection
    function selectDenomination(amount, discount) {
      const pay = amount - discount;
      document.getElementById('summary-denom').textContent = amount.toLocaleString('vi-VN') + 'đ';
      document.getElementById('summary-discount').textContent = '-' + discount.toLocaleString('vi-VN') + 'đ';
      document.getElementById('summary-total').textContent = pay.toLocaleString('vi-VN') + 'đ';
      document.getElementById('btn-pay-text').textContent = "Thanh toán ngay " + pay.toLocaleString('vi-VN') + 'đ';
    }

    // Self phone filler
    function selectSelfPhone() {
      document.getElementById('input-phone').value = "0987345888";
    }

    // PIN Step Flow
    function showPinStep() {
      document.getElementById('box-summary').classList.add('hidden');
      document.getElementById('box-pin').classList.remove('hidden');
      document.getElementById('box-success').classList.add('hidden');
    }

    function cancelPinStep() {
      document.getElementById('box-pin').classList.add('hidden');
      document.getElementById('box-summary').classList.remove('hidden');
      document.getElementById('box-success').classList.add('hidden');
    }

    function completePaymentSuccess() {
      document.getElementById('box-pin').classList.add('hidden');
      document.getElementById('box-summary').classList.add('hidden');
      document.getElementById('box-success').classList.remove('hidden');
    }

    function resetFlow() {
      document.getElementById('box-success').classList.add('hidden');
      document.getElementById('box-pin').classList.add('hidden');
      document.getElementById('box-summary').classList.remove('hidden');
    }
  </script>
