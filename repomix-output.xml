  }

  // Giả lập giao dịch thất bại / hủy thanh toán
  const handleSimulateVnpayCancel = () => {
    setStatus('PENDING')
    setTimeout(() => {
      setStatus('FAILED')
      toast.error('Giao dịch nạp tiền chưa hoàn tất', {
