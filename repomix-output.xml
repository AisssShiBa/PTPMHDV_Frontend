          </div>
        </div>

        <!-- Dòng chú thích bắt buộc dưới bảng -->
        <div class="mt-4 text-center">
          <p class="text-[13px] text-text-muted italic flex items-center justify-center gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-text-muted">info</span>
            Số liệu minh họa cho mục đích học tập.
          </p>
        </div>

      </div>
    </section>

    <!-- 6. SECTION KÊU GỌI (CTA NỀN XANH ĐẬM, CHỮ TRẮNG) -->
    <section id="mo-vi" class="py-20 bg-primary text-white">
      <div class="max-w-[1000px] mx-auto px-6 text-center space-y-8">
        
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-20 bg-white/10 text-white backdrop-blur-sm shadow-inner">
          <span class="material-symbols-outlined fill text-[34px]">rocket_launch</span>
        </div>

        <h2 class="text-[36px] md:text-[44px] font-bold tracking-tight text-white leading-tight">
          Sẵn sàng thử FinVault?
        </h2>

        <p class="text-[17px] md:text-[18px] text-white/85 max-w-[620px] mx-auto leading-relaxed">
          Trải nghiệm môi trường mô phỏng ví điện tử hiện đại, giao diện trực quan và cơ chế kiểm soát minh bạch ngay hôm nay.
        </p>

        <div class="pt-2">
          <a href="#mo-vi-form" class="inline-flex items-center justify-center gap-2.5 h-14 px-9 bg-white text-primary hover:bg-slate-50 text-[16px] font-bold rounded-16 shadow-lg shadow-black/10 transition-all hover:scale-[1.02] active:scale-[0.98]">
            <span>Mở ví ngay</span>
            <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
          </a>
        </div>

      </div>
    </section>

  </main>

  <!-- 7. CHÂN TRANG (FOOTER) -->
  <footer id="ho-tro" class="bg-white border-t border-[#bcc9c5]/50 py-16">
    <div class="max-w-[1280px] mx-auto px-6 space-y-12">
      
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
        
        <!-- Cột Logo & Giới thiệu đồ án (6 cols) -->
        <div class="md:col-span-6 space-y-4 pr-0 md:pr-12">
          <a href="#" class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center text-white">
              <span class="material-symbols-outlined fill text-[24px]">account_balance_wallet</span>
            </div>
            <div>
              <span class="text-[20px] font-bold text-primary block leading-none">FinVault</span>
              <span class="text-[12px] text-text-muted mt-0.5 block">Ví điện tử cá nhân</span>
            </div>
          </a>
          <p class="text-[14px] text-text-muted leading-relaxed">
            Hệ thống giao diện mẫu cho ví điện tử cá nhân được thiết kế nhằm phục vụ mục đích nghiên cứu, học tập giao diện UI/UX và kiến trúc phần mềm tài chính.
          </p>
        </div>

        <!-- Cột Liên kết & Hỗ trợ (6 cols) -->
        <div class="md:col-span-6 grid grid-cols-2 sm:grid-cols-3 gap-6">
          
          <!-- Nhóm Điều khoản & Pháp lý -->
          <div class="space-y-3">
            <div class="text-[14px] font-bold text-text-main uppercase tracking-wider">Tài liệu</div>
            <ul class="space-y-2 text-[14px] text-text-muted">
              <li><a href="#" class="hover:text-primary transition-colors">Điều khoản sử dụng</a></li>
              <li><a href="#" class="hover:text-primary transition-colors">Chính sách bảo mật</a></li>
            </ul>
          </div>

          <!-- Nhóm Tính năng -->
          <div class="space-y-3">
            <div class="text-[14px] font-bold text-text-main uppercase tracking-wider">Điều hướng</div>
            <ul class="space-y-2 text-[14px] text-text-muted">
              <li><a href="#tinh-nang" class="hover:text-primary transition-colors">Tính năng</a></li>
              <li><a href="#bao-mat" class="hover:text-primary transition-colors">Bảo mật</a></li>
              <li><a href="#han-muc" class="hover:text-primary transition-colors">Hạn mức</a></li>
            </ul>
          </div>

          <!-- Nhóm Hỗ trợ -->
          <div class="space-y-3">
            <div class="text-[14px] font-bold text-text-main uppercase tracking-wider">Hỗ trợ</div>
            <ul class="space-y-2 text-[14px] text-text-muted">
              <li><a href="#" class="hover:text-primary transition-colors">Trung tâm hỗ trợ</a></li>
              <li><a href="#" class="hover:text-primary transition-colors">Câu hỏi thường gặp</a></li>
              <li><a href="#" class="hover:text-primary transition-colors">Báo cáo phản hồi</a></li>
            </ul>
          </div>

        </div>

      </div>

      <!-- Dòng tuyên bố bắt buộc và bản quyền -->
      <div class="pt-8 border-t border-slate-100 flex flex-col md:flex-row items-center justify-between gap-4 text-[13px] text-text-muted text-center md:text-left">
        <p class="font-medium text-slate-600">
          FinVault là đồ án học tập mô phỏng ví điện tử, không phải dịch vụ tài chính thật.
        </p>
        <p>
          © 2025 FinVault Project. Tất cả thông tin chỉ mang tính minh họa học tập.
        </p>
      </div>

    </div>
  </footer>

</body>
</html>
