<!-- Interactive Amount Selector Script -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
      const amountInput = document.getElementById('amountInput');
      const chips = document.querySelectorAll('.amount-chip');

      chips.forEach(chip => {
        chip.addEventListener('click', () => {
          // Reset styles
          chips.forEach(c => {
            c.classList.remove('border-primary', 'bg-primary/10', 'text-primary', 'font-semibold');
            c.classList.add('border-[#E2E8F0]', 'bg-white', 'text-on-surface-variant');
          });

          // Activate clicked chip
          chip.classList.add('border-primary', 'bg-primary/10', 'text-primary', 'font-semibold');
          chip.classList.remove('border-[#E2E8F0]', 'bg-white', 'text-on-surface-variant');

          // Extract value text without 'đ'
          const rawText = chip.textContent.trim().replace('đ', '').trim();
          if (amountInput) {
            amountInput.value = rawText;
          }
        });
      });
    });
  </script>
