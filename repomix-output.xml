<file path="src/features/notification/api/notification.queries.ts">
import {
  useInfiniteQuery,
  useMutation,
  useQuery,
  useQueryClient,
  type InfiniteData,
  type QueryClient
} from '@tanstack/react-query'
import { useAuthStore } from '@/features/auth'
import { notificationApi } from './notification.api'
import type { NotificationItem, NotificationListResponse } from '../types/notification.types'

export const notificationKeys = {
  all: ['notifications'] as const,
  lists: (owner = useAuthStore.getState().user?.id ?? '') => [...notificationKeys.all, 'list', owner] as const,
  list: (page: number, limit: number) =>
    [...notificationKeys.lists(), 'page', { page, limit }] as const,
  infinite: (limit: number) => [...notificationKeys.lists(), 'infinite', { limit }] as const
}

type NotificationFeed = InfiniteData<NotificationListResponse, number>

const sameNotification = (left: NotificationItem, right: NotificationItem): boolean => {
  if (left.id === right.id) return true
  return Boolean(left.eventId && right.eventId && left.eventId === right.eventId)
}

const containsNotification = (
  notifications: NotificationItem[] | undefined,
  notification: NotificationItem
): boolean => notifications?.some((item) => sameNotification(item, notification)) ?? false

/**
 * Adds a realtime notification to one cached page and bumps `unreadCount` only
 * for the first page, so the badge cannot be incremented twice for the same
 * notification (dedupe by id, then by eventId).
 */
export function mergeNotificationIntoPage(
  data: NotificationListResponse,
  notification: NotificationItem
): NotificationListResponse {
  if (containsNotification(data.notifications, notification)) return data
  const limit = Math.max(data.pagination.limit, 1)
  const notifications = [notification, ...data.notifications].slice(0, limit)
  return {
    ...data,
    notifications,
    unreadCount:
      data.pagination.page === 1 && !notification.read ? data.unreadCount + 1 : data.unreadCount,
    pagination: { ...data.pagination, total: data.pagination.total + 1 }
  }
}

export function mergeNotificationIntoFeed(
  data: NotificationFeed,
  notification: NotificationItem
): NotificationFeed {
  if (data.pages.some((page) => containsNotification(page.notifications, notification))) return data
  return {
    ...data,
    pages: data.pages.map((page, index) =>
      index === 0
        ? mergeNotificationIntoPage(page, notification)
        : {
            ...page,
            pagination: { ...page.pagination, total: page.pagination.total + 1 }
          }
    )
  }
}

/** True when the notification is already in any cached list (used before toasting). */
export function hasNotificationInCache(
  queryClient: QueryClient,
  notification: NotificationItem
): boolean {
  const listCaches = queryClient.getQueriesData<NotificationListResponse>({
    queryKey: notificationKeys.lists()
  })
  return listCaches.some(([, data]) => {
    if (!data) return false
    if ('notifications' in data) {
      return containsNotification(data.notifications, notification)
    }
    if ('pages' in data) {
      return (data as NotificationFeed).pages.some((page) =>
        containsNotification(page.notifications, notification)
      )
    }
    return false
  })
}

/** Writes a socket notification into every cached list without duplicating it. */
export function applyRealtimeNotification(
  queryClient: QueryClient,
  notification: NotificationItem
): void {
  queryClient.setQueriesData<NotificationListResponse>({ queryKey: notificationKeys.lists() }, (data) =>
    data && 'notifications' in data ? mergeNotificationIntoPage(data, notification) : data
  )
  queryClient.setQueriesData<NotificationFeed>({ queryKey: notificationKeys.lists() }, (data) =>
    data && 'pages' in data ? mergeNotificationIntoFeed(data, notification) : data
  )
}

/** Bell dropdown: one page of the newest notifications. */
export function useNotificationList(page = 1, limit = 8, options?: { enabled?: boolean }) {
  const owner = useAuthStore(state => state.user?.id)
  return useQuery<NotificationListResponse, Error>({
    queryKey: notificationKeys.list(page, limit),
    queryFn: () => notificationApi.getNotifications(page, limit),
    staleTime: 15_000,
    gcTime: 0,
    enabled: Boolean(owner) && options?.enabled !== false
  })
}

/** Full page: keeps loading pages while `pagination.totalPages` is not reached. */
export function useNotificationFeed(limit = 10, options?: { enabled?: boolean }) {
  const owner = useAuthStore(state => state.user?.id)
  return useInfiniteQuery<NotificationListResponse, Error, NotificationFeed, readonly unknown[], number>({
    queryKey: notificationKeys.infinite(limit),
    queryFn: ({ pageParam }) => notificationApi.getNotifications(pageParam, limit),
    initialPageParam: 1,
    getNextPageParam: (lastPage) =>
      lastPage.pagination.page < lastPage.pagination.totalPages
        ? lastPage.pagination.page + 1
        : undefined,
    staleTime: 15_000,
    gcTime: 0,
    enabled: Boolean(owner) && options?.enabled !== false
  })
}

export function useMarkNotificationRead() {
  const queryClient = useQueryClient()
  return useMutation<NotificationItem, Error, string>({
    mutationFn: (id) => notificationApi.markRead(id),
    onSuccess: () => {
      void queryClient.invalidateQueries({ queryKey: notificationKeys.lists() })
    }
  })
}

export function useMarkAllNotificationsRead() {
  const queryClient = useQueryClient()
  return useMutation<{ updatedCount: number }, Error, void>({
    mutationFn: () => notificationApi.markAllRead(),
    onSuccess: () => {
      void queryClient.invalidateQueries({ queryKey: notificationKeys.lists() })
    }
  })
}
</file>

<file path="src/features/notification/components/NotificationCenter.tsx">
import { useMemo, useState } from 'react'
import { Link } from 'react-router-dom'
import { ArrowLeft, Bell, CheckCheck, Clock, CreditCard, Loader2, Shield } from 'lucide-react'
import type { LucideIcon } from 'lucide-react'
import { toast } from 'sonner'
import { useQueryClient } from '@tanstack/react-query'
import { useAuthStore } from '@/features/auth/stores/useAuthStore'
import { Button } from '@/components/ui/button'
import { Badge } from '@/components/ui/badge'
import { Card } from '@/components/ui/card'
import { QueryBoundary } from '@/components/common/QueryBoundary'
import {
  applyRealtimeNotification,
  hasNotificationInCache,
  useMarkAllNotificationsRead,
  useMarkNotificationRead,
  useNotificationFeed
} from '../api/notification.queries'
import { useNotificationSocket } from '../hooks/useNotificationSocket'
import {
  notificationFilter,
  type NotificationFilter,
  type NotificationItem
} from '../types/notification.types'
import { NotificationListItem, isToday } from './NotificationList'

const FEED_PAGE_SIZE = 10

const filters: Array<{ value: NotificationFilter; label: string; icon?: LucideIcon }> = [
  { value: 'ALL', label: 'Tất cả' },
  { value: 'BALANCE', label: 'Biến động số dư', icon: CreditCard },
  { value: 'SECURITY', label: 'Xác thực & bảo mật', icon: Shield }
]

const dedupeById = (items: NotificationItem[]): NotificationItem[] => {
  const seen = new Set<string>()
  return items.filter((item) => {
    if (seen.has(item.id)) return false
    seen.add(item.id)
    return true
  })
}

export function NotificationCenter() {
  const queryClient = useQueryClient()
  const user = useAuthStore((state) => state.user)
  const accessToken = useAuthStore((state) => state.accessToken)
  const [filter, setFilter] = useState<NotificationFilter>('ALL')
  const [unreadOnly, setUnreadOnly] = useState(false)

  const feedQuery = useNotificationFeed(FEED_PAGE_SIZE, { enabled: Boolean(user) })
  const markRead = useMarkNotificationRead()
  const markAllRead = useMarkAllNotificationsRead()

  const handleRealtimeNotification = (notification: NotificationItem) => {
    if (hasNotificationInCache(queryClient, notification)) return
    applyRealtimeNotification(queryClient, notification)
    toast.info(notification.message)
  }

  const socketConnected = useNotificationSocket(
    user?.id ? String(user.id) : undefined,
    accessToken ?? undefined,
    handleRealtimeNotification
  )

  const notifications = useMemo(
    () => dedupeById(feedQuery.data?.pages.flatMap((page) => page.notifications) ?? []),
    [feedQuery.data]
  )
  const unreadCount = feedQuery.data?.pages[0]?.unreadCount ?? 0

  const visible = notifications.filter((item) => {
    if (unreadOnly && item.read) return false
    if (filter === 'ALL') return true
    return notificationFilter(item.type) === filter
  })
  const todayList = visible.filter((item) => isToday(item.createdAt))
  const earlierList = visible.filter((item) => !isToday(item.createdAt))

  const handleMarkRead = (id: string) => {
    markRead.mutate(id, {
      onError: () => toast.error('Không thể cập nhật trạng thái thông báo.')
    })
  }

  const handleMarkAllRead = () => {
    if (unreadCount === 0 || markAllRead.isPending) return
    markAllRead.mutate(undefined, {
      onSuccess: () => toast.success('Đã đánh dấu đọc tất cả thông báo!'),
      onError: () => toast.error('Không thể đánh dấu đọc tất cả thông báo.')
    })
  }

  const renderGroup = (title: string, items: NotificationItem[]) => {
    if (items.length === 0) return null
    return (
      <div className="space-y-3">
        <div className="flex items-center justify-between px-1">
          <span className="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-muted-foreground">
            <Clock className="size-3.5 text-primary" />
            {title}
          </span>
          <span className="text-xs text-muted-foreground">
            {items.filter((item) => !item.read).length} chưa đọc
          </span>
        </div>
        <div className="space-y-2.5">
          {items.map((item) => (
            <NotificationListItem key={item.id} notification={item} onMarkRead={handleMarkRead} />
          ))}
        </div>
      </div>
    )
  }

  return (
    <div className="mx-auto max-w-4xl space-y-6 pb-16">
      <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <div className="mb-1 flex items-center gap-2">
            <Button asChild variant="outline" size="sm" className="h-8 gap-1 px-2.5 text-xs">
              <Link to="/app">
                <ArrowLeft className="size-3.5" />
                Trang chủ
              </Link>
            </Button>
            <Badge className="gap-1 border-primary/20 bg-primary/10 text-xs font-semibold text-primary">
              <Bell className="size-3" />
              {unreadCount} thông báo mới
            </Badge>
            <span className="text-[11px] text-muted-foreground">
              {socketConnected ? 'Đang nhận thông báo trực tiếp' : 'Kết nối trực tiếp đang tắt'}
            </span>
          </div>
          <h1 className="text-2xl font-extrabold tracking-tight text-foreground sm:text-3xl">
            Trung tâm thông báo
          </h1>
          <p className="mt-0.5 text-xs text-muted-foreground sm:text-sm">
            Cập nhật biến động số dư, xác thực hồ sơ và các thay đổi tài khoản FinVault của bạn.
          </p>
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <Button
            type="button"
            variant="outline"
            size="sm"
            onClick={handleMarkAllRead}
            disabled={unreadCount === 0 || markAllRead.isPending}
            className="h-9 gap-1.5 text-xs font-semibold"
          >
            <CheckCheck className="size-4 text-primary" />
            Đọc tất cả
          </Button>
        </div>
      </div>

      <div className="flex flex-col justify-between gap-3 rounded-2xl border border-border bg-muted/50 p-1.5 sm:flex-row sm:items-center">
        <div className="flex items-center gap-1 overflow-x-auto p-0.5">
          {filters.map((item) => {
            const Icon = item.icon
            return (
              <Button
                key={item.value}
                type="button"
                variant={filter === item.value ? 'default' : 'ghost'}
                size="sm"
                onClick={() => setFilter(item.value)}
                className="h-8 gap-1.5 rounded-xl text-xs font-semibold"
              >
                {Icon && <Icon className="size-3.5" />}
                {item.label}
              </Button>
            )
          })}
        </div>

        <div className="flex items-center justify-end px-2">
          <button
            type="button"
            onClick={() => setUnreadOnly((previous) => !previous)}
            className={`flex items-center gap-1.5 rounded-xl border px-3 py-1.5 text-xs font-semibold transition-all ${
              unreadOnly
                ? 'border-primary bg-primary text-primary-foreground shadow-xs'
                : 'border-border bg-card text-muted-foreground hover:text-foreground'
            }`}
          >
            <span className={`size-2 rounded-full ${unreadOnly ? 'bg-white' : 'bg-primary'}`} />
            Chỉ chưa đọc ({unreadCount})
          </button>
        </div>
      </div>

      <QueryBoundary
        query={feedQuery}
        skeleton={
          <div className="flex items-center justify-center gap-2 py-16 text-sm text-muted-foreground" role="status">
            <Loader2 className="size-4 animate-spin text-primary" />
            Đang tải thông báo…
          </div>
        }
        isEmpty={(data) => data.pages.every((page) => page.notifications.length === 0)}
        emptyFallback={
          <Card className="flex flex-col items-center space-y-3 border-border p-12 text-center shadow-xs">
            <div className="flex size-14 items-center justify-center rounded-full bg-muted text-muted-foreground">
              <Bell className="size-6" />
            </div>
            <h3 className="text-base font-bold text-foreground">Không có thông báo nào</h3>
            <p className="max-w-sm text-xs text-muted-foreground">
              Thông báo về giao dịch, xác thực hồ sơ và biến động số dư sẽ xuất hiện tại đây.
            </p>
          </Card>
        }
      >
        {() =>
          visible.length === 0 ? (
            <Card className="flex flex-col items-center space-y-3 border-border p-12 text-center shadow-xs">
              <div className="flex size-14 items-center justify-center rounded-full bg-muted text-muted-foreground">
                <Bell className="size-6" />
              </div>
              <h3 className="text-base font-bold text-foreground">
                Không có thông báo trong mục này
              </h3>
              <p className="max-w-sm text-xs text-muted-foreground">
                Bạn đã xem hết thông báo của bộ lọc hiện tại hoặc chưa có thông báo mới.
              </p>
              <Button
                type="button"
                variant="outline"
                size="sm"
                onClick={() => {
                  setFilter('ALL')
                  setUnreadOnly(false)
                }}
                className="mt-2 text-xs font-semibold"
              >
                Xem tất cả thông báo
              </Button>
            </Card>
          ) : (
            <div className="space-y-6">
              {renderGroup('Hôm nay', todayList)}
              {earlierList.length > 0 && (
                <div className="space-y-3 pt-2">
                  <div className="flex items-center justify-between px-1">
                    <span className="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-muted-foreground">
                      <Clock className="size-3.5" />
                      Trước đó
                    </span>
                  </div>
                  <div className="space-y-2.5">
                    {earlierList.map((item) => (
                      <NotificationListItem
                        key={item.id}
                        notification={item}
                        onMarkRead={handleMarkRead}
                      />
                    ))}
                  </div>
                </div>
              )}

              {feedQuery.hasNextPage && (
                <div className="flex justify-center">
                  <Button
                    type="button"
                    variant="outline"
                    size="sm"
                    onClick={() => void feedQuery.fetchNextPage()}
                    disabled={feedQuery.isFetchingNextPage}
                    className="text-xs font-semibold"
                  >
                    {feedQuery.isFetchingNextPage ? 'Đang tải…' : 'Xem thêm thông báo'}
                  </Button>
                </div>
              )}
            </div>
          )
        }
      </QueryBoundary>
    </div>
  )
}
</file>

<file path="src/features/notification/components/NotificationList.tsx">
import {
  ArrowDownCircle,
  ArrowUpCircle,
  BadgeCheck,
  Bell,
  Clock,
  CreditCard,
  Receipt,
  RotateCcw,
  Store,
  WalletCards,
  XCircle
} from 'lucide-react'
import type { LucideIcon } from 'lucide-react'
import type { NotificationItem, NotificationType } from '../types/notification.types'

interface NotificationVisual {
  title: string
  icon: LucideIcon
  tone: 'primary' | 'warning' | 'success'
}

const DEFAULT_VISUAL: NotificationVisual = {
  title: 'Thông báo',
  icon: Bell,
  tone: 'primary'
}

const visualByType: Record<NotificationType, NotificationVisual> = {
  PAYMENT_SUCCESS: { title: 'Giao dịch thanh toán', icon: CreditCard, tone: 'success' },
  PAYMENT_FAILED: { title: 'Thanh toán thất bại', icon: CreditCard, tone: 'warning' },
  PAYMENT_EXPIRED: { title: 'Thanh toán hết hạn', icon: Clock, tone: 'warning' },
  PAYMENT_REFUNDED: { title: 'Hoàn tiền', icon: RotateCcw, tone: 'success' },
  PAYMENT_CANCELLED: { title: 'Thanh toán đã hủy', icon: XCircle, tone: 'warning' },
  WALLET_CREDITED: { title: 'Biến động số dư', icon: WalletCards, tone: 'success' },
  WALLET_DEBITED: { title: 'Biến động số dư', icon: WalletCards, tone: 'primary' },
  KYC_APPROVED: { title: 'Xác thực hồ sơ', icon: BadgeCheck, tone: 'success' },
  KYC_REJECTED: { title: 'Hồ sơ xác thực bị từ chối', icon: BadgeCheck, tone: 'warning' },
  KYC_TIER_CHANGED: { title: 'Cấp xác thực thay đổi', icon: BadgeCheck, tone: 'primary' },
  MERCHANT_APPROVED: { title: 'Cổng Merchant', icon: Store, tone: 'success' },
  MERCHANT_REJECTED: { title: 'Cổng Merchant', icon: Store, tone: 'warning' },
  TOPUP_SUCCEEDED: { title: 'Nạp tiền thành công', icon: ArrowDownCircle, tone: 'success' },
  CASHOUT_SUCCEEDED: { title: 'Rút tiền thành công', icon: ArrowUpCircle, tone: 'success' },
  CASHOUT_FAILED: { title: 'Rút tiền thất bại', icon: ArrowUpCircle, tone: 'warning' },
  UTILITY_SUCCEEDED: { title: 'Giao dịch tiện ích', icon: Receipt, tone: 'success' },
  UTILITY_FAILED: { title: 'Giao dịch tiện ích thất bại', icon: Receipt, tone: 'warning' },
  UTILITY_REFUNDED: { title: 'Hoàn tiền tiện ích', icon: Receipt, tone: 'success' }
}

/** Unknown enum values (a newer backend) render with the neutral default. */
export function notificationVisual(type: NotificationType | string): NotificationVisual {
  return visualByType[type as NotificationType] ?? DEFAULT_VISUAL
}

const toneClass: Record<NotificationVisual['tone'], string> = {
  primary: 'bg-primary/10 text-primary border-primary/20',
  warning: 'bg-amber-500/10 text-amber-600 border-amber-500/20 dark:text-amber-400',
  success: 'bg-emerald-500/10 text-emerald-600 border-emerald-500/20 dark:text-emerald-400'
}

export function NotificationIcon({ type }: { type: NotificationType | string }) {
  const visual = notificationVisual(type)
  const Icon = visual.icon
  return (
    <div
      className={`flex size-10 shrink-0 items-center justify-center rounded-xl border ${toneClass[visual.tone]}`}
    >
      <Icon className="size-5" aria-hidden="true" />
    </div>
  )
}

export function formatNotificationTime(createdAt: string): string {
  const date = new Date(createdAt)
  if (Number.isNaN(date.getTime())) return ''
  return date.toLocaleString('vi-VN', {
    timeZone: 'Asia/Ho_Chi_Minh',
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  })
}

export function isToday(createdAt: string): boolean {
  const date = new Date(createdAt)
  if (Number.isNaN(date.getTime())) return false
  const now = new Date()
  return (
    date.toLocaleDateString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' }) ===
    now.toLocaleDateString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' })
  )
}

interface NotificationListItemProps {
  notification: NotificationItem
  onMarkRead: (id: string) => void
}

export function NotificationListItem({ notification, onMarkRead }: NotificationListItemProps) {
  const visual = notificationVisual(notification.type)
  return (
    <button
      type="button"
      onClick={() => onMarkRead(notification.id)}
      className={`relative w-full overflow-hidden rounded-2xl border p-4 text-left transition-all hover:border-primary/40 ${
        notification.read
          ? 'border-border/80 bg-card opacity-85'
          : 'border-primary/20 bg-primary/5 shadow-xs'
      }`}
    >
      {!notification.read && <span className="absolute inset-y-0 left-0 w-1 bg-primary" />}
      <div className="flex items-start gap-4">
        <NotificationIcon type={notification.type} />
        <div className="min-w-0 flex-1 space-y-1">
          <div className="flex flex-wrap items-center justify-between gap-2">
            <h3 className="text-sm font-bold text-foreground">{visual.title}</h3>
            <span className="shrink-0 text-[11px] text-muted-foreground">
              {formatNotificationTime(notification.createdAt)}
            </span>
          </div>
          <p className="text-xs leading-relaxed text-muted-foreground sm:text-sm">
            {notification.message}
          </p>
        </div>
      </div>
    </button>
  )
}
</file>

