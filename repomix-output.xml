=\"67\" y=\"77\" />\n                  <rect height=\"5\" rx=\"1\" width=\"5\" x=\"38\" y=\"87\" />\n                  <rect height=\"5\" rx=\"1\" width=\"5\" x=\"56\" y=\"87\" />\n                </svg>\n\n                {/* Logo FinVault nổi bật ở trung tâm */}\n                <div className=\"absolute inset-0 flex items-center justify-center pointer-events-none\">\n                  <div className=\"h-9 w-9 rounded-xl bg-primary text-primary-foreground flex items-center justify-center shadow-lg border-2 border-white\">\n                    <Wallet className=\"h-5 w-5\" />\n                  </div>\n                </div>\n              </div>\n            )}\n          </div>\n\n          {/* Bộ đếm thời gian */}\n          {!isExpired && (\n            <div className=\"flex items-center justify-center gap-2 text-xs text-muted-foreground\">\n              <RefreshCw className=\"h-3.5 w-3.5 animate-spin text-primary\" />\n              <span>\n                Mã QR có hiệu lực trong{' '}\n                <strong className=\"text-foreground font-semibold\">{formatTime(countdown)}</strong>\n              </span>\n            </div>\n          )}\n\n          {/* Hướng dẫn 3 bước thao tác */}\n          <div className=\"p-3.5 rounded-xl bg-muted/40 border border-border/60 text-left space-y-2 text-xs\">\n            <div className=\"flex items-center gap-1.5 font-semibold text-foreground\">\n              <Smartphone className=\"h-4 w-4 text-primary\" />\n              <span>Cách thức đăng nhập:</span>\n            </div>\n            <ol className=\"space-y-1.5 text-muted-foreground list-decimal list-inside pl-1 text-[11px] leading-relaxed\">\n              <li>Mở ứng dụng <strong className=\"text-foreground font-medium\">FinVault</strong> trên điện thoại.</li>\n              <li>Chọn biểu tượng <strong className=\"text-foreground font-medium\">Quét mã</strong> ở góc trên màn hình.</li>\n              <li>Hướng camera vào mã QR và bấm <strong className=\"text-foreground font-medium\">Xác nhận đăng nhập</strong>.</li>\n            </ol>\n          </div>\n\n          {/* Nút mô phỏng xác nhận quét thành công */}\n          <Button\n            type=\"button\"\n            className=\"w-full font-semibold shadow-md shadow-primary/20\"\n            size=\"lg\"\n            onClick={handleSimulateScanSuccess}\n            loading={isScanning}\n            disabled={isExpired}\n          >\n            <CheckCircle2 className=\"mr-2 h-4 w-4 text-emerald-400\" />\n            <span>Xác nhận đã quét trên điện thoại</span>\n            <ArrowRight className=\"ml-2 h-4 w-4\" />\n          </Button>\n\n          {/* Nút chuyển sang Đăng nhập Mật khẩu */}\n          <div className=\"pt-1\">\n            <Button asChild variant=\"outline\" size=\"sm\" className=\"w-full text-xs font-semibold\">\n              <Link to=\"/sign-in\" className=\"flex items-center justify-center gap-1.5\">\n                <Lock className=\"h-3.5 w-3.5\" />\n                <span>Đăng nhập bằng Mật khẩu</span>\n              </Link>\n            </Button>\n          </div>\n        </CardContent>\n      </Card>\n\n      {/* Link dẫn sang Đăng ký */}\n      <div className=\"text-center text-sm text-muted-foreground\">\n        <span>Chưa có tài khoản FinVault? </span>\n        <Link\n          to=\"/sign-up\"\n          className=\"font-semibold text-primary hover:underline inline-flex items-center gap-0.5\"\n        >\n          <span>Mở ví số ngay</span>\n        </Link>\n      </div>\n    </div>\n  )\n}\n\nexport default QrLoginPage\n","usedDeprecatedRules":[]},{"filePath":"/tmp/huu-fe-baseline-ec9e776/src/pages/SignInPage.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/tmp/huu-fe-baseline-ec9e776/src/pages/SignUpPage.tsx","messages":[{"ruleId":"react-hooks/incompatible-library","severity":1,"message":"Compilation Skipped: Use of incompatible library\n\nThis API returns functions which cannot be memoized without leading to stale UI. To prevent this, by default React Compiler will skip memoizing this component/hook. However, you may see issues if values from this API are passed to other components/hooks that are memoized.\n\n/tmp/huu-fe-baseline-ec9e776/src/pages/SignUpPage.tsx:44:27\n  42 |   })\n  43 |\n> 44 |   const currentPassword = watch('password') || ''\n     |                           ^^^^^ React Hook Form's `useForm()` API returns a `watch()` function which cannot be memoized safely.\n  45 |\n  46 |   // Tính toán mức độ mạnh của mật khẩu\n  47 |   const getPasswordStrength = (pwd: string) => {","line":44,"column":27,"nodeType":null,"endLine":44,"endColumn":32}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from 'react'\nimport { useNavigate, Link } from 'react-router-dom'\nimport { useForm } from 'react-hook-form'\nimport { zodResolver } from '@hookform/resolvers/zod'\nimport { toast } from 'sonner'\nimport {\n  Wallet,\n  Mail,\n  Lock,\n  Eye,\n  EyeOff,\n  ArrowRight,\n  ShieldCheck,\n  CheckCircle2,\n  Info\n} from 'lucide-react'\nimport { registerSchema } from '@/features/auth/schemas/auth.schema'\nimport { Button } from '@/components/ui/button'\nimport { Input } from '@/components/ui/input'\nimport { Label } from '@/components/ui/label'\nimport { Card, CardContent } from '@/components/ui/card'\n\nexport function SignUpPage() {\n  const [showPassword, setShowPassword] = useState(false)\n  const [showConfirmPassword, setShowConfirmPassword] = useState(false)\n  const [isSubmitting, setIsSubmitting] = useState(false)\n  const navigate = useNavigate()\n\n  const {\n    register,\n    handleSubmit,\n    watch,\n    formState: { errors }\n  } = useForm<{ email: string; password: string; confirmPassword: string; terms?: boolean }>({\n    resolver: zodResolver(registerSchema),\n    defaultValues: {\n      email: '',\n      password: '',\n      confirmPassword: '',\n      terms: true\n    }\n  })\n\n  const currentPassword = watch('password') || ''\n\n  // Tính toán mức độ mạnh của mật khẩu\n  const getPasswordStrength = (pwd: string) => {\n    if (!pwd) return { score: 0, label: 'Chưa nhập', color: 'bg-muted' }\n    let score = 0\n    if (pwd.length >= 6) score += 1\n    if (pwd.length >= 8) score += 1\n    if (/[0-9]/.test(pwd)) score += 1\n    if (/[A-Z]/.test(pwd) || /[^A-Za-z0-9]/.test(pwd)) score += 1\n\n    if (score <= 1) return { score: 1, label: 'Yếu', color: 'bg-destructive' }\n    if (score === 2) return { score: 2, label: 'Trung bình', color: 'bg-amber-500' }\n    if (score === 3) return { score: 3, label: 'Khá tốt', color: 'bg-emerald-500' }\n    return { score: 4, label: 'Rất mạnh', color: 'bg-primary' }\n  }\n\n  const strength = getPasswordStrength(currentPassword)\n\n  // Xử lý gửi đăng ký\n  const onSubmit = async (data: { email: string; password: string; confirmPassword: string; terms?: boolean }) => {\n    setIsSubmitting(true)\n    try {\n      // Giả lập độ trễ mạng tạo tài khoản\n      await new Promise((resolve) => setTimeout(resolve, 600))\n      toast.success('Đăng ký tài khoản FinVault thành công!')\n      navigate('/sign-in', { state: { email: data.email } })\n    } catch {\n      toast.error('Đăng ký không thành công. Vui lòng thử lại.')\n    } finally {\n      setIsSubmitting(false)\n    }\n  }\n\n  return (\n    <div className=\"w-full max-w-md mx-auto space-y-6\">\n      {/* Brand & Heading */}\n      <div className=\"text-center space-y-2\">\n        <div className=\"inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-primary mb-1 border border-primary/20 shadow-sm\">\n          <Wallet className=\"h-6 w-6\" />\n        </div>\n        <h1 className=\"text-2xl sm:text-3xl font-bold tracking-tight text-foreground\">\n          Tạo tài khoản FinVault\n        </h1>\n        <