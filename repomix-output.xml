import { useEffect, useRef, useState } from 'react'
import { QRCodeSVG } from 'qrcode.react'
import { Button } from '@/components/ui/button'
import {
  Dialog,
  DialogContent,
  DialogTitle,
  DialogDescription,
} from '@/components/ui/dialog'
import { errorMessage } from '@/lib/apiResponse'
import { merchantApi } from '../api/merchant.api'
import type { Outlet, OutletQr } from '../types/outlet.types'
export function OutletQrCard({
  merchantId,
  businessName,
  outlet,
  close,
}: {
  merchantId: string
  businessName: string
  outlet: Outlet
  close: () => void
}) {
  const [qr, setQr] = useState<OutletQr>()
  const [error, setError] = useState<string>()
  const active = useRef(true)
  useEffect(() => {
    active.current = true
    const controller = new AbortController()
    void merchantApi
      .getQr(merchantId, outlet, controller.signal)
      .then((data) => {
        if (active.current) setQr(data)
      })
      .catch((reason) => {
        if (active.current) setError(errorMessage(reason))
      })
    return () => {
      active.current = false
      controller.abort()
    }
  }, [merchantId, outlet])
  return (
    <Dialog open onOpenChange={close}>
      <DialogContent className="max-w-md">
        <DialogTitle>Mã QR điểm bán</DialogTitle>
        <DialogDescription>
          QR do máy chủ cấp cho điểm bán này. Đóng cửa sổ để xóa bản đang xem.
        </DialogDescription>
        {error && <p role="alert">{error}</p>}
        {!qr && !error && <p role="status">Đang lấy mã QR…</p>}
        {qr && (
          <>
            <section
              data-merchant-print
              className="flex flex-col items-center gap-4 rounded-xl border bg-white p-6 text-center text-black"
            >
              <h2 className="font-bold">{businessName}</h2>
              <p>
                {outlet.name} · {outlet.code}
              </p>
              <QRCodeSVG
                value={qr.token}
                size={240}
                marginSize={4}
                title="QR điểm bán do máy chủ cấp"
              />
              <p>Quét mã thanh toán FinVault</p>
            </section>
            <Button onClick={() => window.print()}>In QR điểm bán</Button>
          </>
        )}
      </DialogContent>
    </Dialog>
  )
}
</file>

<file path="src/features/merchant/schemas/outlet.schema.ts">
import { z } from 'zod'
export const outletInputSchema = z
  .object({
    name: z
      .string()
      .trim()
      .min(1, 'Nhập tên điểm bán.')
      .max(200, 'Tên tối đa 200 ký tự.'),
    code: z
      .string()
      .trim()
      .regex(
        /^[A-Za-z0-9_-]{3,64}$/,
        'Mã gồm 3–64 chữ, số, dấu gạch ngang hoặc gạch dưới.',
      ),
  })
  .strict()
export const outletSchema = z.object({
  id: z.uuid(),
  merchantId: z.uuid(),
  name: z.string(),
  code: z.string(),
  createdAt: z.string(),
  updatedAt: z.string(),
})
export const outletPageSchema = z.object({
  content: z.array(outletSchema),
  page: z.number().int().positive(),
  limit: z.number().int().positive(),
  totalElements: z.number().int().nonnegative(),
  totalPages: z.number().int().positive(),
})
export const qrSchema = z.object({
  version: z.literal(1),
  merchantId: z.uuid(),
  outletId: z.uuid(),
  outletCode: z.string(),
  issuedAt: z.number().int().positive(),
  token: z
    .string()
    .min(1)
    .max(2048)
    .regex(/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/),
  signature: z.string(),
  algorithm: z.literal('HMAC-SHA256'),
})
export const keyMetadataSchema = z.object({
  id: z.uuid(),
  keyId: z.uuid(),
  prefix: z.string(),
  revokedAt: z.string().nullable(),
  lastUsedAt: z.string().nullable(),
  createdAt: z.string(),
})
export const createdKeySchema = keyMetadataSchema.extend({
  key: z.string().min(1).max(256),
})
</file>

<file path="src/features/merchant/types/outlet.types.ts">
import type { z } from 'zod'
import type {
  outletSchema,
  outletInputSchema,
  outletPageSchema,
  qrSchema,
  keyMetadataSchema,
} from '../schemas/outlet.schema'
export type Outlet = z.infer<typeof outletSchema>
export type OutletInput = z.infer<typeof outletInputSchema>
export type OutletPage = z.infer<typeof outletPageSchema>
export type OutletQr = z.infer<typeof qrSchema>
