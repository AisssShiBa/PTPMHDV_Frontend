    document.querySelectorAll('.grid-cols-6 input').forEach((elem, index, array) => {
      elem.addEventListener('keyup', (e) => {
        if (e.key >= '0' && e.key <= '9') {
          if (index < array.length - 1) array[index + 1].focus();
