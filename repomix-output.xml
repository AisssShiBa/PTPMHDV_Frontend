ount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/nguyenhuu/Hoc Tap/HDV/PTPMHDV_Frontend/src/features/auth/components/PinModal.tsx","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/home/nguyenhuu/Hoc Tap/HDV/PTPMHDV_Frontend/src/features/auth/components/PinModal.tsx:46:7\n  44 |   useEffect(() => {\n  45 |     if (open) {\n> 46 |       setPin(Array(6).fill(''))\n     |       ^^^^^^ Avoid calling setState() directly within an effect\n  47 |       setErrorMsg(null)\n  48 |       setIsLoading(false)\n  49 |       // Focus vào ô đầu tiên sau khi modal mở","line":46,"column":7,"nodeType":null,"endLine":46,"endColumn":13},{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/home/nguyenhuu/Hoc Tap/HDV/PTPMHDV_Frontend/src/features/auth/components/PinModal.tsx:61:7\n  59 |\n  60 |     if (lockCountdown <= 0) {\n> 61 |       setIsLocked(false)\n     |       ^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  62 |       setAttemptsRemaining(5)\n  63 |       setLockCountdown(300)\n  64 |       setErrorMsg(null)","line":61,"column":7,"nodeType":null,"endLine":61,"endColumn":18}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useRef, useEffect } from 'react'\nimport {\n  Dialog,\n  DialogContent,\n  DialogHeader,\n  DialogTitle,\n  DialogDescription\n} from '@/components/ui/dialog'\nimport { Button } from '@/components/ui/button'\nimport { ShieldCheck, Lock, AlertTriangle, Eye, EyeOff, Delete } from 'lucide-react'\nimport { formatVnd } from '@/lib/format'\n\nexport interface PinModalProps {\n  open: boolean\n  onOpenChange?: (open: boolean) => void\n  title?: string\n  description?: string\n  paymentId?: string\n  amount?: string\n  onSuccess: (transactionToken: string) => void\n  onCancel?: () => void\n}\n\nexport function PinModal({\n  open,\n  onOpenChange,\n  title = 'Xác thực mã PIN giao dịch',\n  description = 'Vui lòng nhập mã PIN bảo mật 6 số để tiếp tục giao dịch.',\n  amount,\n  onSuccess,\n  onCancel\n}: PinModalProps) {\n  const [pin, setPin] = useState<string[]>(Array(6).fill(''))\n  const [showPin, setShowPin] = useState(false)\n  const [isLoading, setIsLoading] = useState(false)\n  const [errorMsg, setErrorMsg] = useState<string | null>(null)\n  const [attemptsRemaining, setAttemptsRemaining] = useState(5)\n  const [isLocked, setIsLocked] = useState(false)\n  const [lockCountdown, setLockCountdown] = useState(300)\n\n  const inputRefs = useRef<(HTMLInputElement | null)[]>([])\n\n  // Reset trạng thái khi mở modal\n  useEffect(() => {\n    if (open) {\n      setPin(Array(6).fill(''))\n      setErrorMsg(null)\n      setIsLoading(false)\n      // Focus vào ô đầu tiên sau khi modal mở\n      setTimeout(() => {\n        inputRefs.current[0]?.focus()\n      }, 100)\n    }\n  }, [open])\n\n  // Đếm ngược khi bị khóa mã PIN (PIN_LOCKED)\n  useEffect(() => {\n    if (!isLocked) return\n\n    if (lockCountdown <= 0) {\n      setIsLocked(false)\n      setAttemptsRemaining(5)\n      setLockCountdown(300)\n      setErrorMsg(null)\n      return\n    }\n\n    const timer = setInterval(() => {\n      setLockCountdown((prev) => prev - 1)\n    }, 1000)\n\n    return () => clearInterval(timer)\n  }, [isLocked, lockCountdown])\n\n  // Xử lý khi gõ ký tự vào từng ô\n  const handleDigitChange = (index: number, value: string) => {\n    if (isLocked || isLoading) return\n\n    // Chỉ nhận ký tự số từ 0 đến 9\n    const cleanValue = value.replace(/\\D/g, '')\n    if (!cleanValue) {\n      const newPin = [...pin]\n      newPin[index] = ''\n      setPin(newPin)\n      return\n    }\n\n    const lastDigit = cleanValue.slice(-1)\n    const newPin = [...pin]\n    newPin[index] = lastDigit\n    setPin(newPin)\n    setErrorMsg(null)\n\n    // Tự động nhảy focus sang ô tiếp theo\n    if (index < 5 && lastDigit) {\n      inputRefs.current[index + 1]?.focus()\n    }\n\n    // Nếu đã nhập đủ 6 số -> Tự động xác thực\n    const fullPin = newPin.join('')\n    if (fullPin.length === 6 && !newPin.includes('')) {\n      verifyPin(fullPin)\n    }\n  }\n\n  // Xử lý phím Backspace điều hướng lùi\n  const handleKeyDown = (index: number, e: React.KeyboardEvent<HTMLInputElement>) => {\n    if (e.key === 'Backspace' && !pin[index] && index > 0) {\n      inputRefs.current[index - 1]?.focus()\n    }\n  }\n\n  // Xử lý dán (Paste) mã 6 số từ clipboard\n  const handlePaste = (e: React.ClipboardEvent<HTMLInputElement>) => {\n    e.preventDefault()\n    if (isLocked || isLoading) return\n\n    const pasteData = e.clipboardData.getData('text').replace(/\\D/g, '').slice(0, 6)\n    if (!pasteData) return\n\n    const newPin = Array(6).fill('')\n    for (let i = 0; i < pasteData.length; i++) {\n      newPin[i] = pasteData[i]\n    }\n    setPin(newPin)\n\n    if (pasteData.length === 6) {\n      verifyPin(pasteData)\n    } else {\n      inputRefs.current[pasteData.length]?.focus()\n    }\n  }\n\n  // Xử lý bàn phím số ảo on-screen\n  const handleVirtualKey = (key: string) => {\n    if (isLocked || isLoading) return\n\n    if (key === 'del') {\n      const lastFilledIndex = pin.findLastIndex((d) => d !== '')\n      if (lastFilledIndex >= 0) {\n        const newPin = [...pin]\n        newPin[lastFilledIndex] = ''\n        setPin(newPin)\n        inputRefs.current[lastFilledIndex]?.focus()\n      }\n      return\n    }\n\n    const firstEmptyIndex = pin.findIndex((d) => d === '')\n    if (firstEmptyIndex !== -1) {\n      handleDigitChange(firstEmptyIndex, key)\n    }\n  }\n\n  // Hàm xác thực mã PIN\n  const verifyPin = async (inputPin: string) => {\n    setIsLoading(true)\n    setErrorMsg(null)\n\n    try {\n      // Giả lập độ trễ xác thực bảo mật 400ms\n      await new Promise((resolve) => setTimeout(resolve, 400))\n\n      // Kịch bản demo: Mã PIN '000000' sẽ cố tình báo sai để kiểm thử trạng thái lỗi\n      if (inputPin === '000000') {\n        const newAttempts = attemptsRemaining - 1\n        setAttemptsRemaining(newAttempts)\n\n        if (newAttempts <= 0) {\n          setIsLocked(true)\n          setErrorMsg('Tài khoản bị tạm khóa giao dịch do nhập sai mã PIN quá 5 lần.')\n        } else {\n          setErrorMsg(`Mã PIN không chính xác. Bạn còn ${newAttempts} lần thử.`)\n        }\n        setPin(Array(6).fill(''))\n        inputRefs.current[0]?.focus()\n        return\n      }\n\n      // Nhập đúng mã PIN (hoặc các mã hợp lệ): sinh transactionToken dùng 1 lần\n      const singleUseToken = 'txn_token_' + Math.random().toString(36).substring(2, 15)\n      onSuccess(singleUseToken)\n      onOpenChange?.(false)\n    } finally {\n      setIsLoading(false)\n    }\n  }\n\n  // Format đếm ngược phút:giây\n  const formatCountdown = (seconds: number) => {\n    const mins = Math.floor(seconds / 60)\n    const secs = seconds % 60\n    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`\n  }\n\n  const handleClose = () => {\n    onCancel?.()\n    onOpenChange?.(false)\n  }\n\n  return (\n    <Dialog open={open} onOpenChange={handleClose}>\n      <DialogContent className=\"max-w-md p-6 sm:p-8 bg-card border-border shadow-2xl rounded-2xl\">\n        <DialogHeader className=\"text-center space-y-2 sm:text-center\">\n          <div className=\"mx-auto h-12 w-12 rounded-2xl bg-primary/10 text-primary border border-primary/20 flex items-center justify-center shadow-sm\">\n            <Lock className=\"h-6 w-6\" />\n          </div>\n          <DialogTitle className=\"text-xl font-bold tracking-tight text-foreground\">\n            {title}\n          </DialogTitle>\n          <DialogDescription className=\"text-xs text-muted-foreground\">\n            {description}\n          </DialogDescription>\n        </DialogHeader>\n\n        {/* Thông tin số tiền giao dịch nếu có */}\n        {amount && (\n          <div className=\"p-3 rounded-xl bg-muted/40 border border-border/60 flex items-center justify-between text-xs\">\n            <span className=\"text-muted-foreground font-medium\">Số tiền thanh toán:</span>\n            <span className=\"font-extrabold text-primary text-base tracking-tight\">\n              {formatVnd(amount)}\n            </span>\n          </div>\n        )}\n\n        {/* Trạng thái bị khóa PIN_LOCKED */}\n        {isLocked ? (\n          <div className=\"p-4 rounded-xl bg-destructive/10 border border-destructive/20 text-center space-y-2\">\n            <div className=\"flex items-center justify-center gap-1.5 text-destructive font-semibold tex